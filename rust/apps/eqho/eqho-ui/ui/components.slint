// Reusable Toolcraft-inspired layout & chrome components for Eqho.
import { Theme } from "@app-theme/theme.slint";
import { Button, ButtonKind, Card } from "@damt-ui/kit.slint";
import { LanguageOption } from "types.slint";
import { Icons, PhIcon, HoverTooltip } from "icons.slint";

// Scrollable container with a thin themed scrollbar when content overflows.
export component ScrollArea inherits Rectangle {
    in property <length> content-height: inner.preferred-height;
    out property <length> scroll-y: -flick.content-y;
    out property <bool> has-scroll: root.content-height > root.height;

    clip: true;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: Math.max(self.height, inner.preferred-height);
        interactive: true;

        inner := VerticalLayout {
            width: flick.width - 10px;
            alignment: start;
            @children
        }
    }

    if root.has-scroll : Rectangle {
        property <length> track-h: Math.max(1px, root.height - 8px);
        property <length> thumb-h: Math.max(24px, self.track-h * root.height / Math.max(1px, root.content-height));
        property <length> max-scroll: Math.max(1px, root.content-height - root.height);
        x: parent.width - 7px;
        y: 4px;
        width: 5px;
        height: self.track-h;

        Rectangle {
            y: (parent.track-h - parent.thumb-h) * Math.clamp(-flick.content-y / parent.max-scroll, 0, 1);
            width: drag.has-hover || drag.pressed ? 5px : 3px;
            x: parent.width - self.width;
            height: parent.thumb-h;
            border-radius: 2.5px;
            background: Theme.text-muted;
            opacity: drag.has-hover || drag.pressed ? 0.75 : 0.4;
        }

        drag := TouchArea {
            property <length> start-y;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.start-y = flick.content-y;
                }
            }
            moved => {
                let denom = Math.max(1px, parent.track-h - parent.thumb-h);
                let delta = (self.mouse-y - self.pressed-y) * parent.max-scroll / denom;
                flick.content-y = Math.clamp(self.start-y - delta, -parent.max-scroll, 0px);
            }
        }
    }
}

// Uppercase muted section header above cards.
export component SectionHeader inherits Rectangle {
    in property <string> text;
    height: label.preferred-height + 4px;
    label := Text {
        x: 0;
        text: root.text;
        font-size: Theme.font-size-sm;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: Theme.text-muted;
        accessible-role: none;
    }
}

// Stacked setting row: label + description above, control below (per DESIGN_SYSTEM.md).
export component StackedSettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: Theme.font-size-base;
        font-weight: 500;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.help != "" : Text {
        text: root.help;
        font-size: Theme.font-size-help;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    VerticalLayout {
        padding-top: 2px;
        spacing: 6px;
        @children
    }
}

// Clean hairline card with an optional integrated header bar separated by a 1px divider line.
export component SectionCard inherits Card {
    in property <string> title: "";
    shadow: false;
    border-color: Theme.border-subtle;

    VerticalLayout {
        spacing: 0px;

        if root.title != "" : VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                padding-left: Theme.space-12;
                padding-right: Theme.space-12;
                padding-top: Theme.space-10;
                padding-bottom: Theme.space-8;
                Text {
                    text: root.title;
                    font-size: Theme.font-size-sm;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                padding-left: 1px;
                padding-right: 1px;
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }
            }
        }

        VerticalLayout {
            padding: Theme.space-12;
            spacing: Theme.space-10;
            @children
        }
    }
}

// Calm banner shown in Microsoft Store builds when the 15-day trial has ended.
export component StoreTrialBanner inherits Card {
    in property <string> title: "Your trial has ended.";
    in property <string> body: "If you'd like to keep using Eqho, please buy it.";
    in property <string> buy-label: "Buy Eqho";
    callback buy-clicked();

    shadow: false;
    border-color: Theme.border;
    min-height: lay.preferred-height;

    accessible-role: groupbox;
    accessible-label: root.title;

    lay := HorizontalLayout {
        padding-left: Theme.space-14;
        padding-right: Theme.space-14;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-12;
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.font-size-base;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: root.body;
                font-size: Theme.font-size-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Button {
                text: root.buy-label;
                kind: ButtonKind.accent;
                accessible-name: root.buy-label;
                clicked => { root.buy-clicked(); }
            }
        }
    }
}

// Quiet one-line footer shown in Microsoft Store builds while a trial is active.
export component StoreTrialFooter inherits Rectangle {
    in property <string> days-left-text: "";
    in property <string> buy-label: "Buy Eqho";
    in property <string> made-with-slint-label: "Made with Slint";
    callback buy-clicked();

    vertical-stretch: 0;
    height: lay.preferred-height;
    background: Theme.surface;

    Rectangle {
        y: 0;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }

    lay := HorizontalLayout {
        padding-left: Theme.space-16;
        padding-right: Theme.space-16;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: Theme.space-8;
        alignment: space-between;

        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;

            Text {
                text: root.days-left-text;
                font-size: Theme.font-size-help;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            Text {
                text: "·";
                font-size: Theme.font-size-help;
                color: Theme.text-subtle;
                vertical-alignment: center;
                accessible-role: none;
            }

            buy-link := Rectangle {
                min-width: buy-txt.preferred-width + 6px;
                min-height: buy-txt.preferred-height + 2px;
                accessible-role: button;
                accessible-label: root.buy-label;
                accessible-action-default => { root.buy-clicked(); }

                buy-txt := Text {
                    text: root.buy-label;
                    font-size: Theme.font-size-help;
                    font-weight: 600;
                    color: buy-touch.pressed ? Theme.accent-text-pressed
                        : buy-touch.has-hover ? Theme.accent-text-pressed
                        : Theme.accent-text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    accessible-role: none;
                }

                buy-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.buy-clicked(); }
                }
            }
        }

        if root.made-with-slint-label != "" : Text {
            text: root.made-with-slint-label;
            font-size: Theme.font-size-help;
            color: Theme.text-subtle;
            vertical-alignment: center;
        }
    }
}

// Recovery banner shown when an automatic paste failed.
// Subtle neutral-warm surface distinct from regular cards, yellow strictly on the status dot,
// 3-line clamped scrollable preview, and fixed-height bottom actions.
export component RecoveryBanner inherits Rectangle {
    in property <string> text;
    callback copy-clicked();
    callback view-history-clicked();
    callback dismiss-clicked();

    background: Theme.dark ? #1B1A16 : #FAF8F2;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.dark ? #363329 : #DDD7C5;
    clip: true;
    min-height: lay.preferred-height;

    lay := VerticalLayout {
        padding-left: Theme.space-14;
        padding-right: Theme.space-14;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-8;

        // Top header row: yellow dot + clear title
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.warning;
                }
            }
            Text {
                text: "Dictation couldn't be pasted automatically";
                font-size: Theme.font-size-sm;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        // Clamped 3-line preview (hover/wheel scrolls full text; subtle ellipsis cue if clipped)
        Rectangle {
            property <length> max-preview-h: 48px;
            property <bool> is-clipped: preview-txt.preferred-height > self.max-preview-h;
            height: Math.min(preview-txt.preferred-height, self.max-preview-h);
            clip: true;

            preview-flick := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: preview-txt.preferred-height;
                interactive: parent.is-clipped;

                preview-txt := Text {
                    width: preview-flick.width;
                    text: root.text;
                    font-size: Theme.font-size-sm;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            if self.is-clipped && (-preview-flick.content-y + self.height + 2px < preview-txt.preferred-height) : Rectangle {
                x: parent.width - 26px;
                y: parent.height - 16px;
                width: 26px;
                height: 16px;
                background: Theme.dark ? #1B1A16 : #FAF8F2;
                Text {
                    text: "…";
                    font-size: Theme.font-size-sm;
                    font-weight: 600;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }
            }
        }

        // Bottom fixed-height action row
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            Button {
                text: "Copy";
                kind: ButtonKind.accent;
                clicked => { root.copy-clicked(); }
            }
            Button {
                text: "View in History";
                kind: ButtonKind.outline;
                clicked => { root.view-history-clicked(); }
            }
            Button {
                text: "Dismiss";
                kind: ButtonKind.text;
                clicked => { root.dismiss-clicked(); }
            }
        }
    }
}

// Compact borderless circular icon button for TopBar utility controls (Guide, Theme, Settings).
export component CircleIconButton inherits Rectangle {
    in property <bool> active: false;
    in property <string> accessible-name;
    in property <string> tooltip: root.accessible-name;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.accent-line : transparent;
    background: root.active ? Theme.accent-muted
        : touch.pressed ? Theme.button-outline-pressed
        : touch.has-hover ? Theme.surface-hover
        : transparent;

    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }

    @children

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                HoverTooltip.text = root.tooltip;
                HoverTooltip.anchor-x = root.absolute-position.x;
                HoverTooltip.anchor-y = root.absolute-position.y;
                HoverTooltip.anchor-w = root.width;
                HoverTooltip.anchor-h = root.height;
                HoverTooltip.visible = true;
            } else if (HoverTooltip.text == root.tooltip) {
                HoverTooltip.visible = false;
            }
        }
        clicked => {
            HoverTooltip.visible = false;
            root.clicked();
        }
    }
}

// Themed single-line text input using built-in TextInput (no std-widgets dependency).
export component ThemedLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <length> font-size: Theme.font-size-base;
    callback edited(string);

    height: 32px;
    border-radius: 9px;
    background: Theme.dark ? Theme.surface-tertiary : Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : Theme.border;
    clip: true;

    if root.text == "" && root.placeholder-text != "" : Text {
        x: 11px;
        width: parent.width - 22px;
        text: root.placeholder-text;
        font-size: root.font-size;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        font-size: root.font-size;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
    }
}

// Themed multi-line text input using built-in TextInput (no std-widgets dependency).
export component ThemedTextEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <length> font-size: Theme.font-size-sm;
    callback edited(string);

    min-height: 64px;
    border-radius: 9px;
    background: Theme.surface-tertiary;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : Theme.border;
    clip: true;

    if root.text == "" && root.placeholder-text != "" : Text {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        text: root.placeholder-text;
        font-size: root.font-size;
        color: Theme.text-muted;
        wrap: word-wrap;
        accessible-role: none;
    }

    input := TextInput {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        height: parent.height - 16px;
        text <=> root.text;
        font-size: root.font-size;
        color: Theme.text;
        single-line: false;
        wrap: word-wrap;
        edited => { root.edited(self.text); }
    }
}

// 68 px GatherOS-inspired top bar: smaller subordinate wordmark (left), prominent floating
// 3-tab capsule pill (center, no search icon), and smaller borderless utility icons (right).
export component TopBar inherits Rectangle {
    in-out property <string> active-tab;
    in property <bool> settings-open: false;
    in property <bool> tour-active: false;
    in property <image> logo-image;
    callback tab-selected(string);
    callback theme-toggled();
    callback settings-clicked();
    callback tour-clicked();

    height: 68px;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: Theme.space-16;
        padding-right: Theme.space-16;
        alignment: space-between;

        // Left: smaller, understated horizontal wordmark
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            width: 120px;

            if root.logo-image.width > 0 : VerticalLayout {
                alignment: center;
                Image {
                    source: root.logo-image;
                    width: 56px;
                    height: 24px;
                    image-fit: contain;
                    image-rendering: smooth;
                    accessible-role: none;
                }
            }
            if root.logo-image.width == 0 : Text {
                text: "eqho";
                font-size: Theme.font-size-lg;
                font-weight: 600;
                color: Theme.accent-text;
                vertical-alignment: center;
            }
        }

        // Center: prominent floating capsule pill nav bar (General · Models · History)
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 42px;
                border-radius: 21px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.dark ? Theme.border : Theme.border-subtle;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.dark ? #00000050 : #00000014;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;

                    for nav-item in [
                        { id: "general", label: "General" },
                        { id: "models", label: "Models" },
                        { id: "history", label: "History" },
                    ] : pill := Rectangle {
                        property <bool> is-active: root.active-tab == nav-item.id;
                        min-width: 98px;
                        height: 34px;
                        border-radius: 17px;
                        background: pill.is-active ? Theme.accent
                            : nav-touch.pressed ? Theme.button-outline-pressed
                            : nav-touch.has-hover ? Theme.surface-hover
                            : transparent;

                        accessible-role: AccessibleRole.tab;
                        accessible-label: nav-item.label;
                        accessible-item-selected: pill.is-active;
                        accessible-action-default => {
                            root.active-tab = nav-item.id;
                            root.tab-selected(nav-item.id);
                        }

                        HorizontalLayout {
                            padding-left: 15px;
                            padding-right: 15px;
                            spacing: 6px;
                            alignment: center;

                            // Unified Phosphor Icons matching GatherOS capsule tabs
                            VerticalLayout {
                                alignment: center;
                                PhIcon {
                                    glyph: nav-item.id == "general" ? Icons.mic
                                        : nav-item.id == "models" ? Icons.models
                                        : Icons.history;
                                    size: 15px;
                                    icon-color: pill.is-active ? Theme.on-accent
                                        : (nav-touch.has-hover ? Theme.text : Theme.text-muted);
                                }
                            }

                            Text {
                                text: nav-item.label;
                                font-size: Theme.font-size-base;
                                font-weight: pill.is-active ? 600 : 500;
                                color: pill.is-active ? Theme.on-accent : (nav-touch.has-hover ? Theme.text : Theme.text-muted);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        nav-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-tab = nav-item.id;
                                root.tab-selected(nav-item.id);
                            }
                        }
                    }
                }
            }
        }

        // Right: smaller, calmer utility icons (Guide/Tour, Theme, Settings popup)
        HorizontalLayout {
            width: 120px;
            alignment: end;
            spacing: 4px;

            VerticalLayout {
                alignment: center;
                CircleIconButton {
                    active: root.tour-active;
                    accessible-name: "Interactive guide";
                    tooltip: "Interactive guide";
                    clicked => { root.tour-clicked(); }
                    PhIcon {
                        glyph: Icons.compass;
                        size: 16px;
                        icon-color: root.tour-active ? Theme.accent-line : Theme.text-muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                CircleIconButton {
                    accessible-name: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
                    tooltip: Theme.dark ? "Light mode" : "Dark mode";
                    clicked => {
                        Theme.dark = !Theme.dark;
                        root.theme-toggled();
                    }
                    PhIcon {
                        glyph: Theme.dark ? Icons.sun : Icons.moon;
                        size: 16px;
                        icon-color: Theme.text-muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                CircleIconButton {
                    active: root.settings-open;
                    accessible-name: "Settings";
                    tooltip: "Settings";
                    clicked => { root.settings-clicked(); }
                    PhIcon {
                        glyph: Icons.settings;
                        size: 16px;
                        icon-color: root.settings-open ? Theme.accent-line : Theme.text-muted;
                    }
                }
            }
        }
    }

    // 1 px bottom hairline
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }
}

// Floating bottom-left contextual walkthrough card (modeled on GatherOS 1/7 coach-mark card).
// Separate from the initial 6-step setup wizard; explains each section live on top of the app.
export component TourCard inherits Rectangle {
    in property <int> step: 0;
    in property <int> total-steps: 4;
    callback next-clicked();
    callback back-clicked();
    callback dismiss-clicked();

    property <string> card-title: root.step == 0 ? "General controls"
        : root.step == 1 ? "Offline speech models"
        : root.step == 2 ? "History & Trash"
        : "Focused Settings";
    property <string> card-body: root.step == 0
        ? "Pick your mic, tune sensitivity, set your global hotkey, and switch between Batch or Live dictation."
        : root.step == 1
            ? "Download local Whisper models and switch between Vulkan GPU acceleration or multi-core CPU anytime."
            : root.step == 2
                ? "Search local transcripts, recover failed pastes with one click, or restore deleted items from Trash."
                : "Click the gear icon anytime to tune the floating pill, replacements, startup, and trashed data retention.";

    width: 304px;
    height: lay.preferred-height;
    border-radius: 14px;
    background: #1C1A19;
    border-width: 1px;
    border-color: #FFFFFF22;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000066;

    lay := VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Top row: step counter + close X
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: (root.step + 1) + "/" + root.total-steps;
                font-size: Theme.font-size-xs;
                font-weight: 500;
                color: #A1A1AA;
                vertical-alignment: center;
            }
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: x-touch.has-hover ? #FFFFFF1A : transparent;
                accessible-role: button;
                accessible-label: "Dismiss guide";
                accessible-action-default => { root.dismiss-clicked(); }
                Path {
                    width: 8px;
                    height: 8px;
                    x: 7px;
                    y: 7px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M1 1 L9 9 M9 1 L1 9";
                    stroke: #A1A1AA;
                    stroke-width: 1.4px;
                    fill: transparent;
                }
                x-touch := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            HoverTooltip.text = "Dismiss guide";
                            HoverTooltip.anchor-x = parent.absolute-position.x;
                            HoverTooltip.anchor-y = parent.absolute-position.y;
                            HoverTooltip.anchor-w = parent.width;
                            HoverTooltip.anchor-h = parent.height;
                            HoverTooltip.visible = true;
                        } else if (HoverTooltip.text == "Dismiss guide") {
                            HoverTooltip.visible = false;
                        }
                    }
                    clicked => {
                        HoverTooltip.visible = false;
                        root.dismiss-clicked();
                    }
                }
            }
        }

        // Title row with matching Phosphor section icon
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                PhIcon {
                    glyph: root.step == 0 ? Icons.mic
                        : root.step == 1 ? Icons.models
                        : root.step == 2 ? Icons.history
                        : Icons.settings;
                    size: 16px;
                    icon-color: #F5F6F8;
                }
            }
            Text {
                text: root.card-title;
                font-size: Theme.font-size-base;
                font-weight: 600;
                color: #F5F6F8;
                vertical-alignment: center;
            }
        }

        // Concise explanation
        Text {
            text: root.card-body;
            font-size: Theme.font-size-sm;
            color: #C7C7CE;
            wrap: word-wrap;
        }

        // Bottom actions: quiet Back link + white capsule Next/Done button
        HorizontalLayout {
            padding-top: 2px;
            alignment: space-between;

            Rectangle {
                horizontal-stretch: 0;
                min-width: root.step > 0 ? 48px : 1px;
                height: 28px;
                if root.step > 0 : Text {
                    text: "Back";
                    font-size: Theme.font-size-sm;
                    font-weight: 500;
                    color: back-touch.has-hover ? #FFFFFF : #A1A1AA;
                    vertical-alignment: center;
                }
                back-touch := TouchArea {
                    enabled: root.step > 0;
                    mouse-cursor: pointer;
                    clicked => { root.back-clicked(); }
                }
            }

            Rectangle {
                height: 30px;
                min-width: 72px;
                border-radius: 15px;
                background: next-touch.pressed ? #D4D4D8 : next-touch.has-hover ? #F4F4F5 : #FFFFFF;
                accessible-role: button;
                accessible-label: root.step + 1 >= root.total-steps ? "Done" : "Next";
                accessible-action-default => { root.next-clicked(); }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: root.step + 1 >= root.total-steps ? "Done" : "Next";
                        font-size: Theme.font-size-sm;
                        font-weight: 600;
                        color: #141416;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                next-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.next-clicked(); }
                }
            }
        }
    }
}

// Language dropdown displaying a crisp 21x14 country flag before each language name.
export component FlagDropdown inherits Rectangle {
    in property <[LanguageOption]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <int> max-rows: 8;
    in property <length> window-height: 0px;
    in property <string> accessible-name: "Language";
    callback selected(int);

    property <length> row-h: 28px;
    property <length> pad: 4px;
    property <length> header-h: 37px;
    property <int> visible-rows: Math.max(1, Math.min(root.model.length, root.max-rows));
    property <length> list-h: root.visible-rows * root.row-h + 2 * root.pad;
    property <length> popup-h: root.header-h + root.list-h;
    property <bool> opens-up: root.window-height > 0px
        && root.absolute-position.y + root.height + 4px + root.popup-h > root.window-height
        && root.absolute-position.y >= root.popup-h + 4px;
    property <int> hl: 0;
    property <length> scroll-y: 0px;
    property <string> search-query: "";

    pure function matches-query(label: string, code: string, q: string) -> bool {
        if (q == "") {
            return true;
        }
        return label.to-lowercase().replace-all(q, "") != label.to-lowercase()
            || code.to-lowercase().replace-all(q, "") != code.to-lowercase();
    }

    function clamp-index(idx: int) -> int {
        Math.max(0, Math.min(idx, Math.max(0, root.model.length - 1)))
    }

    function scroll-into-view(i: int) {
        let total-h = root.model.length * root.row-h + 2 * root.pad;
        let max-sc = Math.max(0px, total-h - root.list-h);
        if (max-sc <= 0px) {
            root.scroll-y = 0px;
            return;
        }
        let top = root.pad + i * root.row-h;
        let bot = top + root.row-h;
        if (top < -root.scroll-y) {
            root.scroll-y = -Math.min(top, max-sc);
        } else if (bot > -root.scroll-y + root.list-h) {
            root.scroll-y = -Math.min(Math.max(0px, bot - root.list-h), max-sc);
        }
    }

    function move-to(idx: int) {
        let clamped = root.clamp-index(idx);
        root.hl = clamped;
        root.scroll-into-view(clamped);
    }

    function pick(idx: int) {
        if (idx >= 0 && idx < root.model.length && idx != root.current-index) {
            root.current-index = idx;
            root.selected(idx);
        }
    }

    function open-popup() {
        if (!root.enabled || root.model.length == 0) { return; }
        root.search-query = "";
        root.hl = root.clamp-index(root.current-index);
        root.scroll-into-view(root.hl);
        popup.show();
    }

    height: 32px;
    border-radius: 9px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent-line : (touch.has-hover && root.enabled) ? Theme.text-muted : Theme.border;
    background: !root.enabled ? Theme.surface-tertiary
        : touch.pressed ? Theme.button-outline-pressed
        : touch.has-hover ? Theme.surface-hover
        : Theme.dark ? #25252C : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.45;

    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index].label : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.open-popup(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            alignment: start;

            if root.current-index >= 0 && root.current-index < root.model.length
                && root.model[root.current-index].flag.width > 0 : VerticalLayout {
                alignment: center;
                Image {
                    source: root.model[root.current-index].flag;
                    width: 21px;
                    height: 14px;
                    image-fit: contain;
                    image-rendering: smooth;
                    accessible-role: none;
                }
            }

            Text {
                text: root.current-index >= 0 && root.current-index < root.model.length
                    ? root.model[root.current-index].label : "";
                font-size: Theme.font-size-label;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Path {
                width: 10px;
                height: 6px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1 L5 5 L9 1";
                stroke: Theme.text-muted;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " " || event.text == Key.DownArrow) {
                root.open-popup();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.open-popup();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.opens-up ? -(root.popup-h + 4px) : root.height + 4px;
        width: root.width;
        height: root.popup-h;
        close-policy: close-on-click-outside;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000038;
            clip: true;

            popup-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow && root.search-query == "") { root.move-to(root.hl - 1); return accept; }
                    if (event.text == Key.DownArrow && root.search-query == "") { root.move-to(root.hl + 1); return accept; }
                    if (event.text == Key.Home && root.search-query == "") { root.move-to(0); return accept; }
                    if (event.text == Key.End && root.search-query == "") { root.move-to(root.model.length - 1); return accept; }
                    if (event.text == Key.PageUp && root.search-query == "") { root.move-to(root.hl - root.max-rows); return accept; }
                    if (event.text == Key.PageDown && root.search-query == "") { root.move-to(root.hl + root.max-rows); return accept; }
                    if (event.text == Key.Escape) {
                        popup.close();
                        focus.focus();
                        return accept;
                    }
                    reject
                }

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;

                    // First pinned section: live Search input (auto-focused on popup open)
                    Rectangle {
                        height: 36px;
                        vertical-stretch: 0;
                        background: Theme.surface-tertiary;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 7px;
                            alignment: start;

                            // Phosphor magnifying glass icon
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                PhIcon {
                                    glyph: Icons.search;
                                    size: 14px;
                                    icon-color: Theme.text-muted;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: parent.height;
                                clip: true;

                                if root.search-query == "" : Text {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Search language…";
                                    font-size: Theme.font-size-label;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }

                                search-input := TextInput {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> root.search-query;
                                    font-size: Theme.font-size-label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    init => { self.focus(); }
                                    edited => {
                                        root.scroll-y = 0px;
                                    }
                                    accepted => {
                                        if (root.search-query == "") {
                                            root.pick(root.hl);
                                            popup.close();
                                            focus.focus();
                                        }
                                    }
                                }
                            }

                            if root.search-query != "" : VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: clr-touch.has-hover ? Theme.surface-hover : transparent;
                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: 6px;
                                        y: 6px;
                                        viewbox-width: 10;
                                        viewbox-height: 10;
                                        commands: "M1 1 L9 9 M9 1 L1 9";
                                        stroke: Theme.text-muted;
                                        stroke-width: 1.4px;
                                        fill: transparent;
                                    }
                                    clr-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-query = "";
                                            root.scroll-y = 0px;
                                            search-input.focus();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Hairline divider between Search bar and language rows
                    Rectangle {
                        height: 1px;
                        vertical-stretch: 0;
                        background: Theme.border-subtle;
                    }

                    // Filtered language list
                    list-viewport := Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        property <string> q-lower: root.search-query.to-lowercase();
                        property <length> content-h: Math.max(list-col.preferred-height, 1px);
                        property <bool> scrolls: list-col.preferred-height > self.height;
                        property <length> max-sc: Math.max(0px, list-col.preferred-height - self.height);

                        flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: list-col.preferred-height;
                            content-width: self.width;
                            content-y <=> root.scroll-y;

                            list-col := VerticalLayout {
                                padding: root.pad;
                                padding-right: root.pad + 8px;

                                for item[i] in root.model : Rectangle {
                                    property <bool> matched: root.matches-query(item.label, item.code, list-viewport.q-lower);
                                    min-height: self.matched ? root.row-h : 0px;
                                    max-height: self.matched ? root.row-h : 0px;
                                    visible: self.matched;
                                    clip: true;
                                    border-radius: Theme.radius-button - 1px;
                                    background: (root.search-query == "" && i == root.hl) ? Theme.button-outline-pressed
                                        : row.has-hover ? Theme.surface-hover
                                        : transparent;

                                    accessible-role: list-item;
                                    accessible-label: item.label;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: i == root.current-index;
                                    accessible-action-default => { root.pick(i); popup.close(); }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;

                                        if item.flag.width > 0 : VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: item.flag;
                                                width: 21px;
                                                height: 14px;
                                                image-fit: contain;
                                                image-rendering: smooth;
                                                accessible-role: none;
                                            }
                                        }

                                        Text {
                                            text: item.label;
                                            font-size: Theme.font-size-label;
                                            font-weight: i == root.current-index ? 600 : 400;
                                            color: i == root.current-index ? Theme.accent-text : Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            accessible-role: none;
                                        }
                                    }

                                    row := TouchArea {
                                        enabled: parent.matched;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.pick(i);
                                            popup.close();
                                        }
                                    }
                                }
                            }
                        }

                        if list-col.preferred-height <= 2 * root.pad && root.search-query != "" : Text {
                            text: "No matching languages";
                            font-size: Theme.font-size-sm;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Thin scrollbar when list overflows
                        if list-viewport.scrolls : Rectangle {
                            property <length> track-h: Math.max(1px, parent.height - 8px);
                            property <length> thumb-h: Math.max(22px, self.track-h * parent.height / list-viewport.content-h);
                            x: parent.width - 7px;
                            y: 4px;
                            width: 4px;
                            height: self.track-h;

                            Rectangle {
                                y: (parent.track-h - parent.thumb-h) * Math.clamp(-root.scroll-y / Math.max(1px, list-viewport.max-sc), 0, 1);
                                width: 4px;
                                height: parent.thumb-h;
                                border-radius: 2px;
                                background: Theme.text-muted;
                                opacity: 0.45;
                            }
                        }
                    }
                }
            }
        }
    }
}
