        stroke: root.secondary;
        stroke-width: 0.35px;
        commands: "M309.74,283.54h-13.09v-95.21h-1.29c-2.4,6.9-5.95,13.28-10.64,19.13-4.7,5.85-10.48,10.55-17.33,14.09-6.86,3.55-14.84,5.32-23.95,5.32-12.85,0-24.09-3.57-33.73-10.71-9.64-7.14-17.09-16.99-22.36-29.56-5.27-12.56-7.91-26.94-7.91-43.15s2.66-30.42,7.98-42.93c5.32-12.51,12.8-22.31,22.44-29.41,9.64-7.09,20.83-10.64,33.58-10.64,9.21,0,17.23,1.73,24.09,5.18,6.85,3.45,12.63,8.08,17.33,13.88,4.7,5.8,8.2,12.15,10.5,19.06h1.58v-35.96h12.8v220.91ZM244.73,214.79c10.83,0,20.14-3.11,27.9-9.35,7.77-6.23,13.74-14.74,17.91-25.53s6.26-22.99,6.26-36.6-2.09-25.74-6.26-36.39-10.14-19.03-17.91-25.17c-7.77-6.13-17.07-9.2-27.9-9.2s-20.28,3.12-28.05,9.35c-7.77,6.23-13.71,14.7-17.83,25.38-4.12,10.69-6.18,22.7-6.18,36.03s2.06,25.53,6.18,36.32c4.12,10.79,10.07,19.34,17.83,25.67,7.77,6.33,17.11,9.49,28.05,9.49Z";
    }
}

// 68 px GatherOS-inspired top bar: crisp pure-vector wordmark (left), prominent floating
// 3-tab capsule pill (center, no search icon), and smaller borderless utility icons (right).
export component TopBar inherits Rectangle {
    in-out property <string> active-tab;
    in property <bool> settings-open: false;
    in property <bool> tour-active: false;
    in property <image> logo-image;
    callback tab-selected(string);
    callback theme-toggled();
    callback settings-clicked();
    callback tour-clicked();

    height: 68px * Theme.scale;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: Theme.space-16;
        padding-right: Theme.space-16;
        alignment: space-between;

        // Left: crisp pure-vector horizontal wordmark (native Slint Path, zero bitmap aliasing)
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            width: 120px * Theme.scale;

            VerticalLayout {
                alignment: center;
                EqhoWordmark {}
            }
        }

        // Center: prominent floating capsule pill nav bar (General · Models · History)
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 42px * Theme.scale;
                border-radius: 21px * Theme.scale;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.dark ? Theme.border : Theme.border-subtle;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.dark ? #00000050 : #00000014;

                HorizontalLayout {
                    padding: 4px * Theme.scale;
                    spacing: 4px * Theme.scale;

                    for nav-item in [
                        { id: "general", label: "General" },
                        { id: "models", label: "Models" },
                        { id: "history", label: "History" },
                    ] : pill := Rectangle {
                        property <bool> is-active: root.active-tab == nav-item.id;
                        min-width: Math.max(94px * Theme.scale, pill-row.preferred-width);
                        height: 34px * Theme.scale;
                        border-radius: 17px * Theme.scale;
                        background: pill.is-active ? Theme.accent
                            : nav-touch.pressed ? Theme.button-outline-pressed
                            : nav-touch.has-hover ? Theme.surface-hover
                            : transparent;

                        accessible-role: AccessibleRole.tab;
                        accessible-label: nav-item.label;
                        accessible-item-selected: pill.is-active;
                        accessible-action-default => {
                            root.active-tab = nav-item.id;
                            root.tab-selected(nav-item.id);
                        }

                        pill-row := HorizontalLayout {
                            padding-left: 14px * Theme.scale;
                            padding-right: 14px * Theme.scale;
                            spacing: 6px * Theme.scale;
                            alignment: center;

                            // Unified Phosphor icon shown ONLY on the active tab (GatherOS style;
                            // unselected tabs remain clean text-only until clicked).
                            if pill.is-active : VerticalLayout {
                                alignment: center;
                                PhIcon {
                                    glyph: nav-item.id == "general" ? Icons.mic
                                        : nav-item.id == "models" ? Icons.models
                                        : Icons.history;
                                    size: 15px;
                                    icon-color: Theme.on-accent;
                                }
                            }

                            Text {
                                text: nav-item.label;
                                font-size: Theme.font-size-base;
                                font-weight: pill.is-active ? 600 : 500;
                                color: pill.is-active ? Theme.on-accent : (nav-touch.has-hover ? Theme.text : Theme.text-muted);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        nav-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-tab = nav-item.id;
                                root.tab-selected(nav-item.id);
                            }
                        }
                    }
                }
            }
        }

        // Right: smaller, calmer utility icons (Guide/Tour, Theme, Settings popup)
        HorizontalLayout {
            width: 120px * Theme.scale;
            alignment: end;
            spacing: 4px * Theme.scale;

            VerticalLayout {
                alignment: center;
                CircleIconButton {
                    active: root.tour-active;
                    accessible-name: "Interactive guide";
                    tooltip: "Interactive guide";
                    clicked => { root.tour-clicked(); }
                    PhIcon {
                        glyph: Icons.compass;
                        size: 16px;
                        icon-color: root.tour-active ? Theme.text : Theme.text-muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                CircleIconButton {
                    accessible-name: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
                    tooltip: Theme.dark ? "Light mode" : "Dark mode";
                    clicked => {
                        Theme.dark = !Theme.dark;
                        root.theme-toggled();
                    }
                    PhIcon {
                        glyph: Theme.dark ? Icons.sun : Icons.moon;
                        size: 16px;
                        icon-color: Theme.text-muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                CircleIconButton {
                    active: root.settings-open;
                    accessible-name: "Settings";
                    tooltip: "Settings";
                    clicked => { root.settings-clicked(); }
                    PhIcon {
                        glyph: Icons.settings;
                        size: 16px;
                        icon-color: root.settings-open ? Theme.text : Theme.text-muted;
                    }
                }
            }
        }
    }

    // 1 px bottom hairline
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }
}

// Floating bottom-left contextual walkthrough card with deep frosted-glass styling:
// - Dark mode: low-opacity deep obsidian glass (#121215) over ultra-high live backdrop blur + solid opaque dark rim
// - Light mode: low-opacity crystal white glass (#FFFFFF) over ultra-high live backdrop blur + solid opaque white rim
export component TourCard inherits Rectangle {
    in property <int> step: 0;
    in property <int> total-steps: 4;
    in property <image> backdrop-image;
    in property <length> viewport-width: 940px;
    in property <length> viewport-height: 560px;
    in property <length> card-x: 16px;
    in property <length> card-y: 360px;
    callback next-clicked();
    callback back-clicked();
    callback dismiss-clicked();

    property <bool> light-card: !Theme.dark;
    property <color> fg-primary: root.light-card ? #1A1C1F : #F5F6F8;
    property <color> fg-body: root.light-card ? #4B4F58 : #C4C8D1;
    property <color> fg-muted: root.light-card ? #74747E : #989DA8;
    property <string> card-title: root.step == 0 ? "General controls"
        : root.step == 1 ? "Offline speech models"
        : root.step == 2 ? "History & Recovery"
        : "Focused Settings";
    property <string> card-body: root.step == 0
        ? "Pick your mic, tune sensitivity, set your global hotkey, and switch between Batch or Live dictation."
        : root.step == 1
            ? "Download and switch between local English and multilingual Whisper models — everything stays 100% offline."
            : root.step == 2
                ? "Search local transcripts, recover unpasted dictations with one click, or restore items from Recently Deleted."
                : "Click the gear icon anytime to tune the floating pill, inference engine, replacements, startup, and storage.";

    width: 308px;
    height: lay.preferred-height;
    border-radius: 14px;
    background: transparent;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: root.light-card ? #00000028 : #00000090;

    // Clipped frosted-glass surface containing the ultra-high-blur backdrop slice + low-opacity glass tint
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 14px;
        clip: true;
        background: transparent;

        if root.backdrop-image.width > 0 : Image {
            x: -root.card-x;
            y: -root.card-y;
            width: root.viewport-width;
            height: root.viewport-height;
            source: root.backdrop-image;
            image-fit: fill;
            image-rendering: smooth;
            accessible-role: none;
        }

        // Ultra-translucent frosted glass tint + crisp 1.5px solid opaque dark rim in both themes
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 14px;
            background: root.light-card
                ? (root.backdrop-image.width > 0 ? #FFFFFF5C : #FFFFFFE6)
                : (root.backdrop-image.width > 0 ? #12121562 : #121215E8);
            border-width: 1.5px;
            border-color: root.light-card ? #2C2C35 : #383844;
        }
    }

    lay := VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Top row: step counter + rounded-square close X
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: (root.step + 1) + "/" + root.total-steps;
                font-size: Theme.font-size-xs;
                font-weight: 500;
                color: root.fg-muted;
                vertical-alignment: center;
            }
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 7px;
                background: x-touch.has-hover
                    ? (root.light-card ? #12121514 : #FFFFFF1A)
                    : transparent;
                accessible-role: button;
                accessible-label: "Dismiss guide";
                accessible-action-default => { root.dismiss-clicked(); }
                Path {
                    width: 8px;
                    height: 8px;
                    x: 8px;
                    y: 8px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M1 1 L9 9 M9 1 L1 9";
                    stroke: x-touch.has-hover ? root.fg-primary : root.fg-muted;
                    stroke-width: 1.4px;
                    fill: transparent;
                }
                x-touch := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            HoverTooltip.text = "Dismiss guide";
                            HoverTooltip.anchor-x = parent.absolute-position.x;
                            HoverTooltip.anchor-y = parent.absolute-position.y;
                            HoverTooltip.anchor-w = parent.width;
                            HoverTooltip.anchor-h = parent.height;
                            HoverTooltip.visible = true;
                        } else if (HoverTooltip.text == "Dismiss guide") {
                            HoverTooltip.visible = false;
                        }
                    }
                    clicked => {
                        HoverTooltip.visible = false;
                        root.dismiss-clicked();
                    }
                }
            }
        }

        // Title row with matching Phosphor section icon
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                PhIcon {
                    glyph: root.step == 0 ? Icons.mic
                        : root.step == 1 ? Icons.models
                        : root.step == 2 ? Icons.history
                        : Icons.settings;
                    size: 16px;
                    icon-color: root.fg-primary;
                }
            }
            Text {
                text: root.card-title;
                font-size: Theme.font-size-base;
                font-weight: 600;
                color: root.fg-primary;
                vertical-alignment: center;
            }
        }

        // Concise explanation
        Text {
            text: root.card-body;
            font-size: Theme.font-size-sm;
            color: root.fg-body;
            wrap: word-wrap;
        }

        // Bottom actions: quiet Back link + high-contrast inverted Next/Done button
        HorizontalLayout {
            padding-top: 2px;
            alignment: space-between;

            Rectangle {
                horizontal-stretch: 0;
                min-width: root.step > 0 ? 48px : 1px;
                height: 28px;
                if root.step > 0 : Text {
                    text: "Back";
                    font-size: Theme.font-size-sm;
                    font-weight: 500;
                    color: back-touch.has-hover ? root.fg-primary : root.fg-muted;
                    vertical-alignment: center;
                }
                back-touch := TouchArea {
                    enabled: root.step > 0;
                    mouse-cursor: pointer;
                    clicked => { root.back-clicked(); }
                }
            }

            Rectangle {
                height: 30px;
                min-width: 72px;
                border-radius: 15px;
                background: root.light-card
                    ? (next-touch.pressed ? #0C0C0E : next-touch.has-hover ? #25252D : #17171B)
                    : (next-touch.pressed ? #D4D4D8 : next-touch.has-hover ? #ECEEF2 : #FFFFFF);
                accessible-role: button;
                accessible-label: root.step + 1 >= root.total-steps ? "Done" : "Next";
                accessible-action-default => { root.next-clicked(); }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        text: root.step + 1 >= root.total-steps ? "Done" : "Next";
                        font-size: Theme.font-size-sm;
                        font-weight: 600;
                        color: root.light-card ? #F4F4F6 : #121215;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                next-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.next-clicked(); }
                }
            }
        }
    }
}

// Language dropdown displaying a crisp 21x14 country flag before each language name.
export component FlagDropdown inherits Rectangle {
    in property <[LanguageOption]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <int> max-rows: 8;
    in property <length> window-height: 0px;
    in property <string> accessible-name: "Language";
    callback selected(int);

    property <length> row-h: 28px;
    property <length> pad: 4px;
    property <length> header-h: 37px;
    property <int> visible-rows: Math.max(1, Math.min(root.model.length, root.max-rows));
    property <length> list-h: root.visible-rows * root.row-h + 2 * root.pad;
    property <length> popup-h: root.header-h + root.list-h;
    property <bool> opens-up: root.window-height > 0px
        && root.absolute-position.y + root.height + 4px + root.popup-h > root.window-height
        && root.absolute-position.y >= root.popup-h + 4px;
    property <int> hl: 0;
    property <length> scroll-y: 0px;
    property <string> search-query: "";

    pure function matches-query(label: string, code: string, q: string) -> bool {
        if (q == "") {
            return true;
        }
        return label.to-lowercase().replace-all(q, "") != label.to-lowercase()
            || code.to-lowercase().replace-all(q, "") != code.to-lowercase();
    }

    function clamp-index(idx: int) -> int {
        Math.max(0, Math.min(idx, Math.max(0, root.model.length - 1)))
    }

    function scroll-into-view(i: int) {
        let total-h = root.model.length * root.row-h + 2 * root.pad;
        let max-sc = Math.max(0px, total-h - root.list-h);
        if (max-sc <= 0px) {
            root.scroll-y = 0px;
            return;
        }
        let top = root.pad + i * root.row-h;
        let bot = top + root.row-h;
        if (top < -root.scroll-y) {
            root.scroll-y = -Math.min(top, max-sc);
        } else if (bot > -root.scroll-y + root.list-h) {
            root.scroll-y = -Math.min(Math.max(0px, bot - root.list-h), max-sc);
        }
    }

    function move-to(idx: int) {
        let clamped = root.clamp-index(idx);
        root.hl = clamped;
        root.scroll-into-view(clamped);
    }

    function pick(idx: int) {
        if (idx >= 0 && idx < root.model.length && idx != root.current-index) {
            root.current-index = idx;
            root.selected(idx);
        }
    }

    function open-popup() {
        if (!root.enabled || root.model.length == 0) { return; }
        root.search-query = "";
        root.hl = root.clamp-index(root.current-index);
        root.scroll-into-view(root.hl);
        popup.show();
    }

    height: 32px * Theme.scale;
    border-radius: 9px * Theme.scale;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent-line : (touch.has-hover && root.enabled) ? Theme.text-muted : Theme.border;
    background: !root.enabled ? Theme.surface-tertiary
        : touch.pressed ? Theme.button-outline-pressed
        : touch.has-hover ? Theme.surface-hover
        : Theme.dark ? #25252C : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.45;

    accessible-role: combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index].label : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.open-popup(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            alignment: start;

            if root.current-index >= 0 && root.current-index < root.model.length
                && root.model[root.current-index].flag.width > 0 : VerticalLayout {
                alignment: center;
                Image {
                    source: root.model[root.current-index].flag;
                    width: 21px;
                    height: 14px;
                    image-fit: contain;
                    image-rendering: smooth;
                    accessible-role: none;
                }
            }

            Text {
                text: root.current-index >= 0 && root.current-index < root.model.length
                    ? root.model[root.current-index].label : "";
                font-size: Theme.font-size-label;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Path {
                width: 10px;
                height: 6px;
                viewbox-width: 10;
                viewbox-height: 6;
                commands: "M1 1 L5 5 L9 1";
                stroke: Theme.text-muted;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " " || event.text == Key.DownArrow) {
                root.open-popup();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.open-popup();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.opens-up ? -(root.popup-h + 4px) : root.height + 4px;
        width: root.width;
        height: root.popup-h;
        close-policy: close-on-click-outside;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000038;
            clip: true;

            popup-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow && root.search-query == "") { root.move-to(root.hl - 1); return accept; }
                    if (event.text == Key.DownArrow && root.search-query == "") { root.move-to(root.hl + 1); return accept; }
                    if (event.text == Key.Home && root.search-query == "") { root.move-to(0); return accept; }
                    if (event.text == Key.End && root.search-query == "") { root.move-to(root.model.length - 1); return accept; }
                    if (event.text == Key.PageUp && root.search-query == "") { root.move-to(root.hl - root.max-rows); return accept; }
                    if (event.text == Key.PageDown && root.search-query == "") { root.move-to(root.hl + root.max-rows); return accept; }
                    if (event.text == Key.Escape) {
                        popup.close();
                        focus.focus();
                        return accept;
                    }
                    reject
                }

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;

                    // First pinned section: live Search input (auto-focused on popup open)
                    Rectangle {
                        height: 36px;
                        vertical-stretch: 0;
                        background: Theme.surface-tertiary;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 7px;
                            alignment: start;

                            // Phosphor magnifying glass icon
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                PhIcon {
                                    glyph: Icons.search;
                                    size: 14px;
                                    icon-color: Theme.text-muted;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: parent.height;
                                clip: true;

                                if root.search-query == "" : Text {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Search language…";
                                    font-size: Theme.font-size-label;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }

                                search-input := TextInput {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> root.search-query;
                                    font-size: Theme.font-size-label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    init => { self.focus(); }
                                    edited => {
                                        root.scroll-y = 0px;
                                    }
                                    accepted => {
                                        if (root.search-query == "") {
                                            root.pick(root.hl);
                                            popup.close();
                                            focus.focus();
                                        }
                                    }
                                }
                            }

                            if root.search-query != "" : VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: clr-touch.has-hover ? Theme.surface-hover : transparent;
                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: 6px;
                                        y: 6px;
                                        viewbox-width: 10;
                                        viewbox-height: 10;
                                        commands: "M1 1 L9 9 M9 1 L1 9";
                                        stroke: Theme.text-muted;
                                        stroke-width: 1.4px;
                                        fill: transparent;
                                    }
                                    clr-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-query = "";
                                            root.scroll-y = 0px;
                                            search-input.focus();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Hairline divider between Search bar and language rows
                    Rectangle {
                        height: 1px;
                        vertical-stretch: 0;
                        background: Theme.border-subtle;
                    }

                    // Filtered language list
                    list-viewport := Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        property <string> q-lower: root.search-query.to-lowercase();
                        property <length> content-h: Math.max(list-col.preferred-height, 1px);
                        property <bool> scrolls: list-col.preferred-height > self.height;
                        property <length> max-sc: Math.max(0px, list-col.preferred-height - self.height);

                        flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: list-col.preferred-height;
                            content-width: self.width;
                            content-y <=> root.scroll-y;

                            list-col := VerticalLayout {
                                padding: root.pad;
                                padding-right: root.pad + 8px;

                                for item[i] in root.model : Rectangle {
                                    property <bool> matched: root.matches-query(item.label, item.code, list-viewport.q-lower);
                                    min-height: self.matched ? root.row-h : 0px;
                                    max-height: self.matched ? root.row-h : 0px;
                                    visible: self.matched;
                                    clip: true;
                                    border-radius: Theme.radius-button - 1px;
                                    background: (root.search-query == "" && i == root.hl) ? Theme.button-outline-pressed
                                        : row.has-hover ? Theme.surface-hover
                                        : transparent;

                                    accessible-role: list-item;
                                    accessible-label: item.label;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: i == root.current-index;
                                    accessible-action-default => { root.pick(i); popup.close(); }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;

                                        if item.flag.width > 0 : VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: item.flag;
                                                width: 21px;
                                                height: 14px;
                                                image-fit: contain;
                                                image-rendering: smooth;
                                                accessible-role: none;
                                            }
                                        }

                                        Text {
                                            text: item.label;
                                            font-size: Theme.font-size-label;
                                            font-weight: i == root.current-index ? 600 : 400;
                                            color: i == root.current-index ? Theme.accent-text : Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            accessible-role: none;
                                        }
                                    }

                                    row := TouchArea {
                                        enabled: parent.matched;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.pick(i);
                                            popup.close();
                                        }
                                    }
                                }
                            }
                        }

                        if list-col.preferred-height <= 2 * root.pad && root.search-query != "" : Text {
                            text: "No matching languages";
                            font-size: Theme.font-size-sm;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        // Thin scrollbar when list overflows
                        if list-viewport.scrolls : Rectangle {
                            property <length> track-h: Math.max(1px, parent.height - 8px);
                            property <length> thumb-h: Math.max(22px, self.track-h * parent.height / list-viewport.content-h);
                            x: parent.width - 7px;
                            y: 4px;
                            width: 4px;
                            height: self.track-h;

                            Rectangle {
                                y: (parent.track-h - parent.thumb-h) * Math.clamp(-root.scroll-y / Math.max(1px, list-viewport.max-sc), 0, 1);
                                width: 4px;
                                height: parent.thumb-h;
                                border-radius: 2px;
                                background: Theme.text-muted;
                                opacity: 0.45;
                            }
                        }
                    }
                }
            }
        }
    }
}
