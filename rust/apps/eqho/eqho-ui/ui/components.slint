// Reusable Toolcraft-inspired layout & chrome components for Eqho.
import { Theme } from "@app-theme/theme.slint";
import { Button, ButtonKind, Card } from "@damt-ui/kit.slint";
import { LanguageOption } from "types.slint";
import { Icons, PhIcon, HoverTooltip } from "icons.slint";

// Scrollable container with a thin themed scrollbar when content overflows.
export component ScrollArea inherits Rectangle {
    in property <length> content-height: inner.preferred-height;
    out property <length> scroll-y: -flick.content-y;
    out property <bool> has-scroll: root.content-height > root.height;

    clip: true;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: self.width;
        content-height: Math.max(self.height, inner.preferred-height);
        // Disable touch-drag scrolling on desktop so dragging Sliders inside a ScrollArea never
        // loses pointer capture to Flickable; mouse wheel and scrollbar dragging keep working.
        interactive: false;

        inner := VerticalLayout {
            x: 0px;
            width: flick.width - 10px;
            alignment: start;
            @children
        }
    }

    if root.has-scroll : Rectangle {
        property <length> track-h: Math.max(1px, root.height - 8px);
        property <length> thumb-h: Math.max(24px, self.track-h * root.height / Math.max(1px, root.content-height));
        property <length> max-scroll: Math.max(1px, root.content-height - root.height);
        x: parent.width - 7px;
        y: 4px;
        width: 5px;
        height: self.track-h;

        Rectangle {
            y: (parent.track-h - parent.thumb-h) * Math.clamp(-flick.content-y / parent.max-scroll, 0, 1);
            width: drag.has-hover || drag.pressed ? 5px : 3px;
            x: parent.width - self.width;
            height: parent.thumb-h;
            border-radius: 2.5px;
            background: Theme.text-muted;
            opacity: drag.has-hover || drag.pressed ? 0.75 : 0.4;
        }

        drag := TouchArea {
            property <length> start-y;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.start-y = flick.content-y;
                }
            }
            moved => {
                let denom = Math.max(1px, parent.track-h - parent.thumb-h);
                let delta = (self.mouse-y - self.pressed-y) * parent.max-scroll / denom;
                flick.content-y = Math.clamp(self.start-y - delta, -parent.max-scroll, 0px);
            }
        }
    }
}

// Uppercase muted section header above cards.
export component SectionHeader inherits Rectangle {
    in property <string> text;
    height: label.preferred-height + 4px;
    label := Text {
        x: 0;
        text: root.text;
        font-size: Theme.font-size-sm;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: Theme.text-muted;
        accessible-role: none;
    }
}

// Stacked setting row: label + description above, control below (per DESIGN_SYSTEM.md).
export component StackedSettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    spacing: 4px;
    Text {
        text: root.label;
        font-size: Theme.font-size-base;
        font-weight: 500;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.help != "" : Text {
        text: root.help;
        font-size: Theme.font-size-help;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    VerticalLayout {
        padding-top: 2px;
        spacing: 6px;
        @children
    }
}

// Clean hairline card with an optional integrated header bar separated by a 1px divider line,
// plus an optional subtle right-aligned header indicator/action pill.
export component SectionCard inherits Card {
    in property <string> title: "";
    in property <string> action-label: "";
    in property <string> action-glyph: "";
    in property <string> action-tooltip: "";
    callback action-clicked();
    shadow: false;
    border-color: Theme.border-subtle;

    VerticalLayout {
        spacing: 0px;

        if root.title != "" : VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                padding-left: Theme.space-12;
                padding-right: root.action-label != "" ? 8px : Theme.space-12;
                padding-top: root.action-label != "" ? 6px : Theme.space-10;
                padding-bottom: root.action-label != "" ? 6px : Theme.space-8;
                alignment: space-between;

                Text {
                    text: root.title;
                    font-size: Theme.font-size-sm;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                if root.action-label != "" : header-action := Rectangle {
                    height: 24px;
                    min-width: act-lay.preferred-width;
                    border-radius: 7px;
                    background: act-touch.pressed ? Theme.button-outline-pressed
                        : act-touch.has-hover ? Theme.surface-hover
                        : transparent;
                    accessible-role: button;
                    accessible-label: root.action-tooltip != "" ? root.action-tooltip : root.action-label;
                    accessible-action-default => { root.action-clicked(); }

                    act-lay := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;

                        if root.action-glyph != "" : VerticalLayout {
                            alignment: center;
                            PhIcon {
                                glyph: root.action-glyph;
                                size: 12px;
                                icon-color: act-touch.has-hover ? Theme.text : Theme.text-muted;
                            }
                        }

                        Text {
                            text: root.action-label;
                            font-size: Theme.font-size-xs;
                            font-weight: 500;
                            color: act-touch.has-hover ? Theme.text : Theme.text-muted;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }

                    act-touch := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (root.action-tooltip != "") {
                                if (self.has-hover) {
                                    HoverTooltip.text = root.action-tooltip;
                                    HoverTooltip.anchor-x = header-action.absolute-position.x;
                                    HoverTooltip.anchor-y = header-action.absolute-position.y;
                                    HoverTooltip.anchor-w = header-action.width;
                                    HoverTooltip.anchor-h = header-action.height;
                                    HoverTooltip.visible = true;
                                } else if (HoverTooltip.text == root.action-tooltip) {
                                    HoverTooltip.visible = false;
                                }
                            }
                        }
                        clicked => {
                            if (root.action-tooltip != "" && HoverTooltip.text == root.action-tooltip) {
                                HoverTooltip.visible = false;
                            }
                            root.action-clicked();
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 1px;
                padding-right: 1px;
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }
            }
        }

        VerticalLayout {
            padding: Theme.space-12;
            spacing: Theme.space-10;
            @children
        }
    }
}

// Calm banner shown in Microsoft Store builds when the 15-day trial has ended.
export component StoreTrialBanner inherits Card {
    in property <string> title: "Your trial has ended.";
    in property <string> body: "If you'd like to keep using Eqho, please buy it.";
    in property <string> buy-label: "Buy Eqho";
    callback buy-clicked();

    shadow: false;
    border-color: Theme.border;
    min-height: lay.preferred-height;

    accessible-role: groupbox;
    accessible-label: root.title;

    lay := HorizontalLayout {
        padding-left: Theme.space-14;
        padding-right: Theme.space-14;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-12;
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.font-size-base;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: root.body;
                font-size: Theme.font-size-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Button {
                text: root.buy-label;
                kind: ButtonKind.accent;
                accessible-name: root.buy-label;
                clicked => { root.buy-clicked(); }
            }
        }
    }
}

// Quiet one-line footer shown in Microsoft Store builds while a trial is active.
// ("Made with Slint" attribution lives in Settings -> About per Slint's Royalty-Free License.)
export component StoreTrialFooter inherits Rectangle {
    in property <string> days-left-text: "";
    in property <string> buy-label: "Buy Eqho";
    callback buy-clicked();
    callback brand-clicked();

    vertical-stretch: 0;
    height: lay.preferred-height;
    background: Theme.surface;

    Rectangle {
        y: 0;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }

    lay := HorizontalLayout {
        padding-left: Theme.space-16;
        padding-right: Theme.space-16;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: Theme.space-8;
        alignment: space-between;

        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;

            Text {
                text: root.days-left-text;
                font-size: Theme.font-size-help;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            Text {
                text: "·";
                font-size: Theme.font-size-help;
                color: Theme.text-subtle;
                vertical-alignment: center;
                accessible-role: none;
            }

            buy-link := Rectangle {
                min-width: buy-txt.preferred-width + 6px;
                min-height: buy-txt.preferred-height + 2px;
                accessible-role: button;
                accessible-label: root.buy-label;
                accessible-action-default => { root.buy-clicked(); }

                buy-txt := Text {
                    text: root.buy-label;
                    font-size: Theme.font-size-help;
                    font-weight: 600;
                    color: buy-touch.pressed ? Theme.accent-text-pressed
                        : buy-touch.has-hover ? Theme.accent-text-pressed
                        : Theme.accent-text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    accessible-role: none;
                }

                buy-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.buy-clicked(); }
                }
            }
        }

        brand-link := Rectangle {
            min-width: brand-txt.preferred-width + 4px;
            min-height: brand-txt.preferred-height + 2px;
            accessible-role: button;
            accessible-label: "Made by damt.xyz";
            accessible-action-default => { root.brand-clicked(); }

            brand-txt := Text {
                text: "Made by damt.xyz";
                font-size: Theme.font-size-help;
                color: brand-touch.has-hover ? Theme.text-muted : Theme.text-subtle;
                vertical-alignment: center;
                horizontal-alignment: center;
                accessible-role: none;
            }

            brand-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.brand-clicked(); }
            }
        }
    }
}

// Recovery banner shown when an automatic paste failed.
// Subtle neutral-warm surface distinct from regular cards, yellow strictly on the status dot,
// 3-line clamped scrollable preview, and fixed-height bottom actions.
export component RecoveryBanner inherits Rectangle {
    in property <string> text;
    in property <string> paste-target-label: "";
    callback paste-previous-clicked();
    callback copy-clicked();
    callback view-history-clicked();
    callback dismiss-clicked();

    background: Theme.dark ? #1B1A16 : #FAF8F2;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.dark ? #363329 : #DDD7C5;
    clip: true;
    min-height: lay.preferred-height;

    lay := VerticalLayout {
        padding-left: Theme.space-14;
        padding-right: Theme.space-14;
        padding-top: Theme.space-10;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-8;

        // Top header row: yellow dot + clear title
        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.warning;
                }
            }
            Text {
                text: root.paste-target-label != ""
                    ? "Not pasted — no text box was focused"
                    : "Dictation couldn't be pasted automatically";
                font-size: Theme.font-size-sm;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        // Clamped 3-line preview (hover/wheel scrolls full text; subtle ellipsis cue if clipped)
        Rectangle {
            property <length> max-preview-h: 48px;
            property <bool> is-clipped: preview-txt.preferred-height > self.max-preview-h;
            height: Math.min(preview-txt.preferred-height, self.max-preview-h);
            clip: true;

            preview-flick := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: preview-txt.preferred-height;
                interactive: parent.is-clipped;

                preview-txt := Text {
                    width: preview-flick.width;
                    text: root.text;
                    font-size: Theme.font-size-sm;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            if self.is-clipped && (-preview-flick.content-y + self.height + 2px < preview-txt.preferred-height) : Rectangle {
                x: parent.width - 26px;
                y: parent.height - 16px;
                width: 26px;
                height: 16px;
                background: Theme.dark ? #1B1A16 : #FAF8F2;
                Text {
                    text: "…";
                    font-size: Theme.font-size-sm;
                    font-weight: 600;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }
            }
        }

        // Bottom fixed-height action row
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            if root.paste-target-label != "" : Button {
                text: "Paste to " + root.paste-target-label;
                kind: ButtonKind.accent;
                clicked => { root.paste-previous-clicked(); }
            }
            Button {
                text: "Copy";
                kind: root.paste-target-label != "" ? ButtonKind.outline : ButtonKind.accent;
                clicked => { root.copy-clicked(); }
            }
            Button {
                text: "View in History";
                kind: ButtonKind.outline;
                clicked => { root.view-history-clicked(); }
            }
            Button {
                text: "Dismiss";
                kind: ButtonKind.text;
                clicked => { root.dismiss-clicked(); }
            }
        }
    }
}

// Compact rounded-square utility icon button for TopBar controls (Guide, Theme, Settings).
export component CircleIconButton inherits Rectangle {
    in property <bool> active: false;
    in property <string> accessible-name;
    in property <string> tooltip: root.accessible-name;
    callback clicked();

    width: 28px * Theme.scale;
    height: 28px * Theme.scale;
    border-radius: 9px * Theme.scale;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.border : transparent;
    background: root.active ? Theme.surface-hover
        : touch.pressed ? Theme.button-outline-pressed
        : touch.has-hover ? Theme.surface-hover
        : transparent;

    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }

    @children

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                HoverTooltip.text = root.tooltip;
                HoverTooltip.anchor-x = root.absolute-position.x;
                HoverTooltip.anchor-y = root.absolute-position.y;
                HoverTooltip.anchor-w = root.width;
                HoverTooltip.anchor-h = root.height;
                HoverTooltip.visible = true;
            } else if (HoverTooltip.text == root.tooltip) {
                HoverTooltip.visible = false;
            }
        }
        clicked => {
            HoverTooltip.visible = false;
            root.clicked();
        }
    }
}

// Themed single-line text input using built-in TextInput (no std-widgets dependency).
export component ThemedLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <length> font-size: Theme.font-size-base;
    callback edited(string);

    height: 32px * Theme.scale;
    border-radius: 9px * Theme.scale;
    background: Theme.dark ? Theme.surface-tertiary : Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : Theme.border;
    clip: true;

    if root.text == "" && root.placeholder-text != "" : Text {
        x: 11px;
        width: parent.width - 22px;
        text: root.placeholder-text;
        font-size: root.font-size;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        font-size: root.font-size;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
    }
}

// Themed multi-line text input using built-in TextInput (no std-widgets dependency).
export component ThemedTextEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <length> font-size: Theme.font-size-sm;
    callback edited(string);

    min-height: 64px * Theme.scale;
    border-radius: 9px * Theme.scale;
    background: Theme.surface-tertiary;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : Theme.border;
    clip: true;

    if root.text == "" && root.placeholder-text != "" : Text {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        text: root.placeholder-text;
        font-size: root.font-size;
        color: Theme.text-muted;
        wrap: word-wrap;
        accessible-role: none;
    }

    input := TextInput {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        height: parent.height - 16px;
        text <=> root.text;
        font-size: root.font-size;
        color: Theme.text;
        single-line: false;
        wrap: word-wrap;
        edited => { root.edited(self.text); }
    }
}

