// History Tab: Search, period filter, Trash bin with retention, failed-paste highlight,
// Copy-state feedback, and inline delete confirmations.
import { Theme } from "@app-theme/theme.slint";
import { Button, ButtonKind, CloseButton, Dropdown } from "@damt-ui/kit.slint";
import { HistoryRowItem } from "types.slint";
import { ScrollArea, SectionCard, ThemedLineEdit } from "components.slint";
import { Icons, PhIcon, HoverTooltip } from "icons.slint";

// Outline button matching ButtonKind.outline with a crisp Phosphor trash-can icon.
component TrashButton inherits Rectangle {
    in property <int> count: 0;
    callback clicked();

    property <string> label-text: root.count > 0 ? "Recently Deleted (" + root.count + ")" : "Recently Deleted";

    min-width: content.preferred-width + 20px * Theme.scale;
    min-height: 31px * Theme.scale;
    max-height: self.min-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 9px * Theme.scale;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.button-outline-pressed
        : touch.has-hover ? Theme.surface-hover
        : Theme.dark ? #FFFFFF08 : Theme.surface;

    accessible-role: button;
    accessible-label: root.label-text;
    accessible-action-default => { root.clicked(); }

    content := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            PhIcon {
                glyph: Icons.trash;
                size: 15px;
                icon-color: Theme.text;
            }
        }

        Text {
            text: root.label-text;
            font-size: Theme.font-size-label;
            font-weight: 400;
            color: Theme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HistoryTab inherits Rectangle {
    in property <length> window-height: 560px;

    in-out property <string> history-query: "";
    in-out property <int> history-period-index: 0;
    in property <[HistoryRowItem]> history-rows: [];
    in-out property <string> history-status: "";
    in-out property <bool> showing-trash: false;
    in-out property <int> trash-count: 0;
    in-out property <string> trash-retention-label: "Recently Deleted auto-clears after 30 days";
    in-out property <string> copied-ts-key: "";

    callback history-filter-changed();
    callback export-history();
    callback clear-history();
    callback copy-history-entry(string, string);
    callback delete-history-entry(string);
    callback toggle-trash-view(bool);
    callback restore-trash-entry(string);
    callback delete-trash-permanently(string);
    callback empty-trash();

    property <string> confirm-delete-ts: "";
    property <bool> confirm-clear-all: false;
    property <bool> confirm-empty-trash: false;

    ScrollArea {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding: Theme.space-16;
            spacing: Theme.space-12;

            // Toolbar — normal History mode
            if !root.showing-trash : HorizontalLayout {
                spacing: Theme.space-8;
                ThemedLineEdit {
                    horizontal-stretch: 1;
                    text <=> root.history-query;
                    placeholder-text: "Search transcripts — keywords or date…";
                    edited => { root.history-filter-changed(); }
                }
                Dropdown {
                    model: ["All time", "Today", "Yesterday", "Last 7 days", "Last 30 days"];
                    current-index <=> root.history-period-index;
                    window-height: root.window-height;
                    accessible-name: "Time period";
                    selected => { root.history-filter-changed(); }
                }
                TrashButton {
                    count: root.trash-count;
                    clicked => {
                        root.confirm-delete-ts = "";
                        root.confirm-clear-all = false;
                        root.confirm-empty-trash = false;
                        root.toggle-trash-view(true);
                    }
                }
                Button {
                    text: "Export .txt";
                    kind: ButtonKind.outline;
                    enabled: root.history-rows.length > 0;
                    clicked => { root.export-history(); }
                }
                Button {
                    text: "Clear All";
                    kind: ButtonKind.outline;
                    enabled: root.history-rows.length > 0;
                    clicked => {
                        root.confirm-delete-ts = "";
                        root.confirm-clear-all = true;
                    }
                }
            }

            // Toolbar — Trash view
            if root.showing-trash : HorizontalLayout {
                spacing: Theme.space-10;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Theme.space-10;
                    alignment: start;
                    Button {
                        text: "← Back to History";
                        kind: ButtonKind.outline;
                        clicked => {
                            root.confirm-delete-ts = "";
                            root.confirm-clear-all = false;
                            root.confirm-empty-trash = false;
                            root.toggle-trash-view(false);
                        }
                    }
                    Text {
                        text: root.trash-retention-label;
                        font-size: Theme.font-size-xs;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                Button {
                    text: "Empty Recently Deleted";
                    kind: ButtonKind.outline;
                    enabled: root.history-rows.length > 0;
                    clicked => {
                        root.confirm-delete-ts = "";
                        root.confirm-empty-trash = true;
                    }
                }
            }

            // Inline confirmation banner: Clear All -> Recently Deleted
            if root.confirm-clear-all && !root.showing-trash : Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.warning;
                min-height: clear-confirm-lay.preferred-height;

                clear-confirm-lay := HorizontalLayout {
                    padding-left: Theme.space-14;
                    padding-right: Theme.space-14;
                    padding-top: Theme.space-10;
                    padding-bottom: Theme.space-10;
                    spacing: Theme.space-10;
                    alignment: space-between;

                    Text {
                        text: "Move all dictations to Recently Deleted? You can restore them anytime before auto-clear.";
                        font-size: Theme.font-size-sm;
                        color: Theme.text;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: Theme.space-8;
                        alignment: center;
                        Button {
                            text: "Move to Recently Deleted";
                            kind: ButtonKind.accent;
                            clicked => {
                                root.confirm-clear-all = false;
                                root.clear-history();
                            }
                        }
                        Button {
                            text: "Cancel";
                            kind: ButtonKind.outline;
                            clicked => { root.confirm-clear-all = false; }
                        }
                    }
                }
            }

            // Inline confirmation banner: Empty Recently Deleted forever
            if root.confirm-empty-trash && root.showing-trash : Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.error;
                min-height: empty-confirm-lay.preferred-height;

                empty-confirm-lay := HorizontalLayout {
                    padding-left: Theme.space-14;
                    padding-right: Theme.space-14;
                    padding-top: Theme.space-10;
                    padding-bottom: Theme.space-10;
                    spacing: Theme.space-10;
                    alignment: space-between;

                    Text {
                        text: "Permanently delete everything in Recently Deleted? This cannot be undone.";
                        font-size: Theme.font-size-sm;
                        color: Theme.text;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: Theme.space-8;
                        alignment: center;
                        Button {
                            text: "Delete forever";
                            kind: ButtonKind.accent;
                            clicked => {
                                root.confirm-empty-trash = false;
                                root.empty-trash();
                            }
                        }
                        Button {
                            text: "Cancel";
                            kind: ButtonKind.outline;
                            clicked => { root.confirm-empty-trash = false; }
                        }
                    }
                }
            }

            if root.history-rows.length > 0 || root.history-status != "" : HorizontalLayout {
                alignment: space-between;
                spacing: Theme.space-8;
                Text {
                    text: root.history-rows.length == 0
                        ? ""
                        : root.showing-trash
                            ? (root.history-rows.length == 1
                                ? "1 recently deleted item"
                                : root.history-rows.length + " recently deleted items")
                            : (root.history-rows.length == 1
                                ? "1 transcript"
                                : root.history-rows.length + " transcripts");
                    font-size: Theme.font-size-xs;
                    color: Theme.text-muted;
                }
                if root.history-status != "" : Text {
                    text: root.history-status;
                    font-size: Theme.font-size-xs;
                    font-weight: 600;
                    color: Theme.accent-text;
                }
            }

            // Empty state
            if root.history-rows.length == 0 : SectionCard {
                Text {
                    text: root.showing-trash
                        ? "No recently deleted transcripts."
                        : (root.history-query != "" || root.history-period-index != 0)
                            ? "No matches."
                            : "No dictations yet — press the hotkey and speak.";
                    font-size: Theme.font-size-base;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }

            // Transcript rows
            for row in root.history-rows : Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius-card;
                border-width: (row.paste_failed && !root.showing-trash) ? 1.5px : 1px;
                border-color: (row.paste_failed && !root.showing-trash)
                    ? Theme.warning
                    : Theme.border-subtle;
                min-height: row-lay.preferred-height;

                row-lay := HorizontalLayout {
                    padding: Theme.space-14;
                    spacing: Theme.space-12;
                    alignment: space-between;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 5px;

                        HorizontalLayout {
                            spacing: Theme.space-8;
                            alignment: start;

                            Text {
                                text: row.meta_text != "" ? row.timestamp_text + "  ·  " + row.meta_text : row.timestamp_text;
                                font-size: Theme.font-size-xs;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }

                            if row.paste_failed && !root.showing-trash : HorizontalLayout {
                                spacing: 5px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.warning;
                                    }
                                }
                                Text {
                                    text: "Not pasted";
                                    font-size: Theme.font-size-xs;
                                    font-weight: 600;
                                    color: Theme.warning;
                                    vertical-alignment: center;
                                }
                            }

                            if root.showing-trash && row.trash_expiry_text != "" : Text {
                                text: "·  " + row.trash_expiry_text;
                                font-size: Theme.font-size-xs;
                                color: Theme.text-subtle;
                                vertical-alignment: center;
                            }
                        }

                        // Read-only TextInput so users can highlight & Ctrl+C any portion of a
                        // transcript without making local history editable.
                        TextInput {
                            text: row.text;
                            read-only: true;
                            font-size: Theme.font-size-base;
                            color: Theme.text;
                            selection-background-color: Theme.accent-selected;
                            selection-foreground-color: Theme.text;
                            single-line: false;
                            wrap: word-wrap;
                            accessible-label: "Transcript text";
                        }
                    }

                    // Normal History row controls (Copy right before ×, plus inline confirm)
                    if !root.showing-trash && root.confirm-delete-ts != row.ts_key : HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        alignment: start;
                        Button {
                            text: root.copied-ts-key == row.ts_key ? "Copied" : "Copy";
                            kind: root.copied-ts-key == row.ts_key ? ButtonKind.accent : ButtonKind.outline;
                            clicked => { root.copy-history-entry(row.ts_key, row.text); }
                        }
                        del-btn := CloseButton {
                            accessible-name: "Move to Recently Deleted";
                            hover-changed(h) => {
                                if (h) {
                                    HoverTooltip.text = "Move to Recently Deleted";
                                    HoverTooltip.anchor-x = self.absolute-position.x;
                                    HoverTooltip.anchor-y = self.absolute-position.y;
                                    HoverTooltip.anchor-w = self.width;
                                    HoverTooltip.anchor-h = self.height;
                                    HoverTooltip.visible = true;
                                } else if (HoverTooltip.text == "Move to Recently Deleted") {
                                    HoverTooltip.visible = false;
                                }
                            }
                            clicked => {
                                root.confirm-clear-all = false;
                                root.confirm-delete-ts = row.ts_key;
                            }
                        }
                    }

                    if !root.showing-trash && root.confirm-delete-ts == row.ts_key : HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        alignment: start;
                        Text {
                            height: 30px;
                            text: "Delete?";
                            font-size: Theme.font-size-xs;
                            font-weight: 600;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Confirm";
                            kind: ButtonKind.accent;
                            clicked => {
                                root.confirm-delete-ts = "";
                                root.delete-history-entry(row.ts_key);
                            }
                        }
                        Button {
                            text: "Cancel";
                            kind: ButtonKind.outline;
                            clicked => { root.confirm-delete-ts = ""; }
                        }
                    }

                    // Trash row controls (Restore, Copy, Delete forever with confirmation)
                    if root.showing-trash && root.confirm-delete-ts != row.ts_key : HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        alignment: start;
                        Button {
                            text: "Restore";
                            kind: ButtonKind.outline;
                            clicked => { root.restore-trash-entry(row.ts_key); }
                        }
                        Button {
                            text: root.copied-ts-key == row.ts_key ? "Copied" : "Copy";
                            kind: root.copied-ts-key == row.ts_key ? ButtonKind.accent : ButtonKind.text;
                            clicked => { root.copy-history-entry(row.ts_key, row.text); }
                        }
                        perm-del-btn := CloseButton {
                            accessible-name: "Delete forever";
                            hover-changed(h) => {
                                if (h) {
                                    HoverTooltip.text = "Delete forever";
                                    HoverTooltip.anchor-x = self.absolute-position.x;
                                    HoverTooltip.anchor-y = self.absolute-position.y;
                                    HoverTooltip.anchor-w = self.width;
                                    HoverTooltip.anchor-h = self.height;
                                    HoverTooltip.visible = true;
                                } else if (HoverTooltip.text == "Delete forever") {
                                    HoverTooltip.visible = false;
                                }
                            }
                            clicked => {
                                root.confirm-empty-trash = false;
                                root.confirm-delete-ts = row.ts_key;
                            }
                        }
                    }

                    if root.showing-trash && root.confirm-delete-ts == row.ts_key : HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        alignment: start;
                        Text {
                            height: 30px;
                            text: "Delete forever?";
                            font-size: Theme.font-size-xs;
                            font-weight: 600;
                            color: Theme.error;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Delete";
                            kind: ButtonKind.accent;
                            clicked => {
                                root.confirm-delete-ts = "";
                                root.delete-trash-permanently(row.ts_key);
                            }
                        }
                        Button {
                            text: "Cancel";
                            kind: ButtonKind.outline;
                            clicked => { root.confirm-delete-ts = ""; }
                        }
                    }
                }
            }
        }
    }
}
