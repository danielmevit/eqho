// Models Tab: Inference Engine + Storage top row, Whisper model cards (English Optimized & Multilingual).
import { Theme } from "@app-theme/theme.slint";
import { Button, ButtonKind, ProgressLine, TabList } from "@damt-ui/kit.slint";
import { ModelCardItem } from "types.slint";
import { ScrollArea, SectionCard } from "components.slint";

// Clean 28x28 circular icon-led status indicator (no loud green pills).
// - Active: solid Eqho-blue circle + crisp white checkmark
// - Ready (cached): tinted Eqho-blue circle + Eqho-blue checkmark
// - Downloading: tinted Eqho-blue circle + animated 3-dot indicator
// - Error: subtle circle with error border + clickable retry icon
// - Not downloaded: muted neutral circle + clickable grey download arrow
component ModelStatusIcon inherits Rectangle {
    in property <bool> is-selected: false;
    in property <bool> is-cached: false;
    in property <bool> is-downloading: false;
    in property <bool> has-error: false;
    callback download-clicked();

    property <bool> clickable: !root.is-cached && !root.is-downloading;
    property <int> dot-phase: Math.mod(Math.floor(animation-tick() / 240ms), 4);

    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.is-selected && root.is-cached ? Theme.accent-line
        : root.has-error ? Theme.error
        : root.is-downloading || root.is-cached ? Theme.accent-line
        : touch.has-hover ? Theme.accent-line
        : Theme.border-subtle;
    background: root.is-selected && root.is-cached ? Theme.accent
        : root.is-downloading || root.is-cached ? Theme.accent-muted
        : touch.pressed && root.clickable ? Theme.button-outline-pressed
        : touch.has-hover && root.clickable ? Theme.button-outline-hover
        : Theme.surface-tertiary;

    accessible-role: button;
    accessible-enabled: root.clickable;
    accessible-label: root.is-selected && root.is-cached ? "Active model"
        : root.is-downloading ? "Downloading"
        : root.has-error ? "Download failed, click to retry"
        : root.is-cached ? "Downloaded"
        : "Download model";

    // Active or Cached checkmark
    if root.is-cached && !root.is-downloading : Path {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.is-selected ? Theme.on-accent : Theme.accent-text;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 5 12.5 L 10 17.5 L 19 7.5";
    }

    // Downloading animated 3 dots (Eqho blue)
    if root.is-downloading : HorizontalLayout {
        alignment: center;
        spacing: 2.5px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent-text;
                opacity: root.dot-phase == 0 ? 1.0 : 0.32;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent-text;
                opacity: root.dot-phase == 1 ? 1.0 : 0.32;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent-text;
                opacity: root.dot-phase == 2 ? 1.0 : 0.32;
            }
        }
    }

    // Error retry icon
    if root.has-error && !root.is-downloading && !root.is-cached : Path {
        width: 13px;
        height: 13px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.error;
        stroke-width: 2.0px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 20 11 A 8 8 0 1 0 18.2 16.5 M 20 5 L 20 11 L 14 11";
    }

    // Not downloaded: muted grey download arrow (turns Eqho-blue on hover)
    if !root.is-cached && !root.is-downloading && !root.has-error : Path {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: touch.has-hover ? Theme.accent-text : Theme.text-muted;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M 12 4 L 12 15 M 7.5 11 L 12 15.5 L 16.5 11 M 5 19.5 L 19 19.5";
    }

    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.download-clicked(); }
    }
}

component ModelCard inherits Rectangle {
    in property <ModelCardItem> item;
    callback select-clicked(string);
    callback download-clicked(string);
    callback delete-clicked(string);

    property <bool> is-active: root.item.is_selected && root.item.is_cached && !root.item.is_downloading;

    background: Theme.bg;
    border-radius: Theme.radius-card;
    border-width: root.is-active ? 2px : 1px;
    border-color: root.is-active ? Theme.accent-line
        : root.item.is_downloading ? Theme.accent-line
        : Theme.border-subtle;
    min-height: lay.preferred-height;
    horizontal-stretch: 1;

    lay := VerticalLayout {
        padding: Theme.space-12;
        spacing: Theme.space-8;

        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: space-between;

            Text {
                text: root.item.name;
                font-size: Theme.font-size-base;
                font-weight: 600;
                color: Theme.text;
                horizontal-stretch: 1;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                ModelStatusIcon {
                    is-selected: root.is-active;
                    is-cached: root.item.is_cached;
                    is-downloading: root.item.is_downloading;
                    has-error: root.item.has_error;
                    download-clicked => { root.download-clicked(root.item.key); }
                }
            }
        }

        Text {
            text: root.item.detail;
            font-size: Theme.font-size-sm;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.item.recommendation != "" : Text {
            text: root.item.recommendation;
            font-size: Theme.font-size-sm;
            color: Theme.accent-text;
            wrap: word-wrap;
        }

        if root.item.is_downloading && root.item.download_detail != "" : Text {
            text: root.item.download_detail;
            font-size: Theme.font-size-xs;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.item.is_downloading : ProgressLine {
            progress: root.item.progress;
            accessible-name: root.item.name + " download progress";
        }

        // Flexible spacer keeps the action row pinned to the bottom at uniform height
        // even when a sibling card in the same 2-column row is taller.
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-8;
            alignment: start;

            if !root.is-active && !root.item.is_downloading && root.item.is_cached : Button {
                text: "Select";
                kind: ButtonKind.accent;
                clicked => { root.select-clicked(root.item.key); }
            }

            if !root.item.is_cached && !root.item.is_downloading : Button {
                text: root.item.has_error ? "Try again" : "Download";
                kind: root.item.has_error ? ButtonKind.outline : ButtonKind.accent;
                clicked => { root.download-clicked(root.item.key); }
            }

            if root.item.is_cached && !root.is-active && !root.item.is_downloading : Button {
                text: "Delete";
                kind: ButtonKind.outline;
                clicked => { root.delete-clicked(root.item.key); }
            }

            if root.item.is_downloading : Text {
                height: 30px;
                text: "Downloading…";
                font-size: Theme.font-size-sm;
                font-weight: 500;
                color: Theme.accent-text;
                vertical-alignment: center;
            }

            if root.is-active : Text {
                height: 30px;
                text: "Active model";
                font-size: Theme.font-size-sm;
                font-weight: 600;
                color: Theme.accent-text;
                vertical-alignment: center;
            }
        }
    }
}

export component ModelsTab inherits Rectangle {
    in-out property <string> hardware-summary: "On this PC, speech models run on your graphics card.";
    in-out property <int> engine-backend-index: 0;
    in property <[ModelCardItem]> english-models: [];
    in property <[ModelCardItem]> multilingual-models: [];
    in-out property <string> model-dir-display: "";

    callback engine-backend-changed(int);
    callback select-model(string);
    callback download-model(string);
    callback delete-model(string);
    callback open-model-folder();

    property <bool> two-col: root.width >= 720px;

    ScrollArea {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding: Theme.space-16;
            spacing: Theme.space-12;

            // TOP ROW: INFERENCE ENGINE (left) + STORAGE (right)
            if root.two-col : HorizontalLayout {
                spacing: Theme.space-12;
                alignment: stretch;

                SectionCard {
                    horizontal-stretch: 1;
                    title: "INFERENCE ENGINE";
                    Text {
                        text: root.hardware-summary;
                        font-size: Theme.font-size-sm;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                    }
                    TabList {
                        items: ["Auto", "GPU (Vulkan)", "CPU"];
                        selected <=> root.engine-backend-index;
                        accessible-name: "Inference Engine";
                        picked(i) => { root.engine-backend-changed(i); }
                    }
                }

                SectionCard {
                    horizontal-stretch: 1;
                    title: "STORAGE";
                    HorizontalLayout {
                        spacing: Theme.space-10;
                        alignment: space-between;
                        Text {
                            text: root.model-dir-display != "" ? root.model-dir-display : "Default cache folder";
                            font-size: Theme.font-size-sm;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            Button {
                                text: "Open Folder";
                                kind: ButtonKind.outline;
                                clicked => { root.open-model-folder(); }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                    }
                    Text {
                        text: "Models download once over HTTPS from huggingface.co/ggerganov/whisper.cpp and stay 100% offline.";
                        font-size: Theme.font-size-xs;
                        color: Theme.text-subtle;
                        wrap: word-wrap;
                    }
                }
            }

            if !root.two-col : VerticalLayout {
                spacing: Theme.space-12;

                SectionCard {
                    title: "INFERENCE ENGINE";
                    Text {
                        text: root.hardware-summary;
                        font-size: Theme.font-size-sm;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    TabList {
                        items: ["Auto", "GPU (Vulkan)", "CPU"];
                        selected <=> root.engine-backend-index;
                        accessible-name: "Inference Engine";
                        picked(i) => { root.engine-backend-changed(i); }
                    }
                }

                SectionCard {
                    title: "STORAGE";
                    HorizontalLayout {
                        spacing: Theme.space-10;
                        alignment: space-between;
                        Text {
                            text: root.model-dir-display != "" ? root.model-dir-display : "Default cache folder";
                            font-size: Theme.font-size-sm;
                            color: Theme.text-muted;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            Button {
                                text: "Open Folder";
                                kind: ButtonKind.outline;
                                clicked => { root.open-model-folder(); }
                            }
                        }
                    }
                    Text {
                        text: "Models download once over HTTPS from huggingface.co/ggerganov/whisper.cpp and stay 100% offline.";
                        font-size: Theme.font-size-xs;
                        color: Theme.text-subtle;
                        wrap: word-wrap;
                    }
                }
            }

            // ENGLISH OPTIMIZED
            SectionCard {
                title: "ENGLISH OPTIMIZED";
                if root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for row-idx in Math.ceil(root.english-models.length / 2) : HorizontalLayout {
                        spacing: Theme.space-10;
                        ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.english-models[row-idx * 2];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 < root.english-models.length : ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.english-models[row-idx * 2 + 1];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 >= root.english-models.length : Rectangle {
                            width: (parent.width - Theme.space-10) / 2;
                        }
                    }
                }
                if !root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for m in root.english-models : ModelCard {
                        item: m;
                        select-clicked(k) => { root.select-model(k); }
                        download-clicked(k) => { root.download-model(k); }
                        delete-clicked(k) => { root.delete-model(k); }
                    }
                }
            }

            // MULTILINGUAL
            SectionCard {
                title: "MULTILINGUAL";
                if root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for row-idx in Math.ceil(root.multilingual-models.length / 2) : HorizontalLayout {
                        spacing: Theme.space-10;
                        ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.multilingual-models[row-idx * 2];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 < root.multilingual-models.length : ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.multilingual-models[row-idx * 2 + 1];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 >= root.multilingual-models.length : Rectangle {
                            width: (parent.width - Theme.space-10) / 2;
                        }
                    }
                }
                if !root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for m in root.multilingual-models : ModelCard {
                        item: m;
                        select-clicked(k) => { root.select-model(k); }
                        download-clicked(k) => { root.download-model(k); }
                        delete-clicked(k) => { root.delete-model(k); }
                    }
                }
            }
        }
    }
}
