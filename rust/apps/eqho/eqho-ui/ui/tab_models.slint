// Models Tab: Whisper model cards (English Optimized & Multilingual) with a subtle Engine settings shortcut.
import { Theme } from "@app-theme/theme.slint";
import { Button, ButtonKind, ProgressLine } from "@damt-ui/kit.slint";
import { ModelCardItem } from "types.slint";
import { ScrollArea, SectionCard } from "components.slint";
import { Icons, PhIcon, HoverTooltip } from "icons.slint";

// Clean 28x28 borderless rounded-square download icon (hidden completely once a model is downloaded):
// - Not downloaded: muted/grayed-out download icon; brightens with a whiter tile on hover (clickable)
// - Downloading: soft Eqho-blue tile + animated blue arrow gliding into a fixed tray
// - Error: subtle tinted tile + clickable red retry icon
component ModelStatusIcon inherits Rectangle {
    in property <bool> is-downloading: false;
    in property <bool> has-error: false;
    callback download-clicked();

    property <bool> clickable: !root.is-downloading;
    // Continuous 1.2s downward glide cycle (phase-offset by +0.45 so t=0 static frames show the arrow centered).
    property <float> dl-t: root.is-downloading
        ? Math.mod(Math.mod(animation-tick() / 1ms, 1200) / 1200.0 + 0.45, 1.0)
        : 0.45;
    property <length> arrow-dy: (-5.5 + root.dl-t * 10.5) * 1px;
    property <float> arrow-alpha: root.dl-t < 0.18
        ? (root.dl-t / 0.18)
        : root.dl-t > 0.78
            ? ((1.0 - root.dl-t) / 0.22)
            : 1.0;
    property <string> tooltip-text: root.is-downloading ? "Downloading model…"
        : root.has-error ? "Download failed — click to retry"
        : "Download model";

    width: 28px * Theme.scale;
    height: 28px * Theme.scale;
    border-radius: 8px * Theme.scale;
    border-width: 0px;
    background: root.is-downloading ? Theme.accent-muted
        : root.has-error ? (touch.has-hover ? (Theme.dark ? #F43F5E30 : #DC262622) : (Theme.dark ? #F43F5E1C : #DC262614))
        : touch.pressed && root.clickable ? (Theme.dark ? #FFFFFF2C : #00000018)
        : touch.has-hover && root.clickable ? (Theme.dark ? #FFFFFF20 : #00000012)
        : (Theme.dark ? #FFFFFF08 : #00000006);

    accessible-role: button;
    accessible-enabled: root.clickable;
    accessible-label: root.tooltip-text;

    // Downloading: blue arrow smoothly gliding into a fixed tray (centered cleanly in the 28x28 tile)
    if root.is-downloading : Rectangle {
        x: 6.5px;
        y: 6.5px;
        width: 15px;
        height: 15px;

        // Clipped region above the tray floor so the gliding arrow tucks cleanly into the tray
        Rectangle {
            x: 0px;
            y: 0px;
            width: 15px;
            height: 12px;
            clip: true;

            Path {
                x: 0px;
                y: root.arrow-dy;
                width: 15px;
                height: 15px;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: "M 8 2.5 L 8 10.5 M 4.7 7.3 L 8 10.6 L 11.3 7.3";
                stroke: Theme.accent-text;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
                opacity: root.arrow-alpha;
            }
        }

        // Fixed bottom tray (stays anchored while the arrow glides into it)
        Path {
            x: 0px;
            y: 0px;
            width: 15px;
            height: 15px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2.5 10.8 L 2.5 13 C 2.5 13.7 3.1 14.3 3.8 14.3 L 12.2 14.3 C 12.9 14.3 13.5 13.7 13.5 13 L 13.5 10.8";
            stroke: Theme.accent-text;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }

    // Error retry icon (Phosphor)
    if root.has-error && !root.is-downloading : PhIcon {
        glyph: Icons.retry;
        size: 15px;
        icon-color: Theme.error;
    }

    // Not downloaded: grayed-out download icon that brightens to crisp white/ink on hover
    if !root.is-downloading && !root.has-error : PhIcon {
        glyph: Icons.download;
        size: 15px;
        icon-color: touch.has-hover ? Theme.text : (Theme.dark ? #6C6C78 : #A0A7B2);
    }

    touch := TouchArea {
        mouse-cursor: root.clickable ? pointer : default;
        changed has-hover => {
            if (self.has-hover) {
                HoverTooltip.text = root.tooltip-text;
                HoverTooltip.anchor-x = root.absolute-position.x;
                HoverTooltip.anchor-y = root.absolute-position.y;
                HoverTooltip.anchor-w = root.width;
                HoverTooltip.anchor-h = root.height;
                HoverTooltip.visible = true;
            } else if (HoverTooltip.text == root.tooltip-text) {
                HoverTooltip.visible = false;
            }
        }
        clicked => {
            if (root.clickable) {
                HoverTooltip.visible = false;
                root.download-clicked();
            }
        }
    }
}

component ModelCard inherits Rectangle {
    in property <ModelCardItem> item;
    callback select-clicked(string);
    callback download-clicked(string);
    callback cancel-download-clicked(string);
    callback delete-clicked(string);

    property <bool> is-active: root.item.is_selected && root.item.is_cached && !root.item.is_downloading;

    // Active card gets a crisp 1px solid Eqho-blue outline; inactive cards stay calm obsidian neutral.
    background: Theme.dark
        ? (root.is-active ? #202028 : Theme.surface-tertiary)
        : Theme.bg;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.is-active
        ? Theme.accent-line
        : (Theme.dark ? #303038 : Theme.border-subtle);
    min-height: lay.preferred-height;
    horizontal-stretch: 1;

    lay := VerticalLayout {
        padding: Theme.space-12;
        spacing: Theme.space-8;

        HorizontalLayout {
            min-height: 28px * Theme.scale;
            spacing: Theme.space-8;
            alignment: space-between;

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px * Theme.scale;
                alignment: start;

                Text {
                    text: root.item.name;
                    font-size: Theme.font-size-base;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                }

                // Subtle Eqho-blue sparkle badge right next to the title for PC-recommended models;
                // hovering displays "Recommended for this PC" without cluttering the card body.
                if root.item.recommendation != "" : VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    rec-badge := Rectangle {
                        width: 20px * Theme.scale;
                        height: 20px * Theme.scale;
                        border-radius: 6px * Theme.scale;
                        background: rec-touch.has-hover ? Theme.accent-muted : transparent;
                        accessible-role: text;
                        accessible-label: root.item.recommendation;

                        PhIcon {
                            glyph: Icons.sparkle;
                            size: 14px;
                            icon-color: Theme.accent-text;
                        }

                        rec-touch := TouchArea {
                            changed has-hover => {
                                if (self.has-hover) {
                                    HoverTooltip.text = root.item.recommendation;
                                    HoverTooltip.anchor-x = rec-badge.absolute-position.x;
                                    HoverTooltip.anchor-y = rec-badge.absolute-position.y;
                                    HoverTooltip.anchor-w = rec-badge.width;
                                    HoverTooltip.anchor-h = rec-badge.height;
                                    HoverTooltip.visible = true;
                                } else if (HoverTooltip.text == root.item.recommendation) {
                                    HoverTooltip.visible = false;
                                }
                            }
                        }
                    }
                }
            }

            // Active card top-right: signature Eqho waveform icon (distinct from the check-circle
            // inside the bottom Active pill — zero duplicate checkmarks).
            if root.is-active : VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                active-wave := Rectangle {
                    width: 28px * Theme.scale;
                    height: 28px * Theme.scale;
                    border-radius: 8px * Theme.scale;
                    background: Theme.accent-muted;
                    accessible-role: none;

                    PhIcon {
                        glyph: Icons.waveform;
                        size: 15px;
                        icon-color: Theme.accent-text;
                    }

                    TouchArea {
                        changed has-hover => {
                            if (self.has-hover) {
                                HoverTooltip.text = "Active speech model";
                                HoverTooltip.anchor-x = active-wave.absolute-position.x;
                                HoverTooltip.anchor-y = active-wave.absolute-position.y;
                                HoverTooltip.anchor-w = active-wave.width;
                                HoverTooltip.anchor-h = active-wave.height;
                                HoverTooltip.visible = true;
                            } else if (HoverTooltip.text == "Active speech model") {
                                HoverTooltip.visible = false;
                            }
                        }
                    }
                }
            }

            if !root.item.is_cached || root.item.is_downloading : VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                ModelStatusIcon {
                    is-downloading: root.item.is_downloading;
                    has-error: root.item.has_error;
                    download-clicked => { root.download-clicked(root.item.key); }
                }
            }
        }

        Text {
            text: root.item.detail;
            font-size: Theme.font-size-sm;
            color: Theme.text-muted;
            wrap: word-wrap;
        }

        if root.item.is_downloading : ProgressLine {
            progress: root.item.progress;
            accessible-name: root.item.name + " download progress";
        }

        // Flexible spacer keeps the action row pinned to the bottom at uniform height
        // even when a sibling card in the same 2-column row is taller.
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-8;
            alignment: start;

            if !root.is-active && !root.item.is_downloading && root.item.is_cached : Button {
                text: "Select";
                kind: ButtonKind.outline;
                clicked => { root.select-clicked(root.item.key); }
            }

            if !root.item.is_cached && !root.item.is_downloading : Button {
                text: root.item.has_error ? "Try again" : "Download";
                kind: ButtonKind.outline;
                clicked => { root.download-clicked(root.item.key); }
            }

            if root.item.is_cached && !root.is-active && !root.item.is_downloading : Button {
                text: "Delete";
                kind: ButtonKind.outline;
                clicked => { root.delete-clicked(root.item.key); }
            }

            if root.item.is_downloading : Button {
                text: "Cancel";
                kind: ButtonKind.outline;
                clicked => { root.cancel-download-clicked(root.item.key); }
            }

            if root.item.is_downloading : Text {
                height: 30px;
                horizontal-stretch: 1;
                text: root.item.download_detail != "" ? root.item.download_detail : "Downloading…";
                font-size: Theme.font-size-xs;
                font-weight: 500;
                color: Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.is-active : Rectangle {
                min-width: active-state-row.preferred-width + 20px;
                min-height: active-state-row.preferred-height + 12px;
                max-height: self.min-height;
                horizontal-stretch: 0;
                vertical-stretch: 0;
                border-radius: 9px;
                border-width: 0px;
                background: root.item.is_loading ? Theme.accent-muted : Theme.accent;
                accessible-role: text;
                accessible-label: root.item.is_loading ? "Loading model" : "Active model";

                active-state-row := HorizontalLayout {
                    spacing: 5px;
                    alignment: center;

                    if !root.item.is_loading : VerticalLayout {
                        alignment: center;
                        PhIcon {
                            glyph: Icons.check-circle;
                            size: 13px;
                            icon-color: Theme.on-accent;
                        }
                    }

                    Text {
                        text: root.item.is_loading ? "Loading…" : "Active";
                        font-size: Theme.font-size-label;
                        font-weight: 500;
                        color: root.item.is_loading ? Theme.accent-text : Theme.on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component ModelsTab inherits Rectangle {
    in property <int> engine-backend-index: 0;
    in property <[ModelCardItem]> english-models: [];
    in property <[ModelCardItem]> multilingual-models: [];

    callback open-engine-settings();
    callback select-model(string);
    callback download-model(string);
    callback cancel-download-model(string);
    callback delete-model(string);

    property <bool> two-col: root.width >= 720px;
    property <string> engine-chip-label: root.engine-backend-index == 1 ? "Engine: GPU"
        : root.engine-backend-index == 2 ? "Engine: CPU"
        : "Engine: Auto";

    ScrollArea {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding: Theme.space-16;
            spacing: Theme.space-12;

            // ENGLISH OPTIMIZED
            SectionCard {
                title: "ENGLISH OPTIMIZED";
                action-glyph: Icons.settings;
                action-label: root.engine-chip-label;
                action-tooltip: "Configure inference engine & model storage in Settings";
                action-clicked => { root.open-engine-settings(); }
                if root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for row-idx in Math.ceil(root.english-models.length / 2) : HorizontalLayout {
                        spacing: Theme.space-10;
                        ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.english-models[row-idx * 2];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            cancel-download-clicked(k) => { root.cancel-download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 < root.english-models.length : ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.english-models[row-idx * 2 + 1];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            cancel-download-clicked(k) => { root.cancel-download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 >= root.english-models.length : Rectangle {
                            width: (parent.width - Theme.space-10) / 2;
                        }
                    }
                }
                if !root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for m in root.english-models : ModelCard {
                        item: m;
                        select-clicked(k) => { root.select-model(k); }
                        download-clicked(k) => { root.download-model(k); }
                        cancel-download-clicked(k) => { root.cancel-download-model(k); }
                        delete-clicked(k) => { root.delete-model(k); }
                    }
                }
            }

            // MULTILINGUAL
            SectionCard {
                title: "MULTILINGUAL";
                if root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for row-idx in Math.ceil(root.multilingual-models.length / 2) : HorizontalLayout {
                        spacing: Theme.space-10;
                        ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.multilingual-models[row-idx * 2];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            cancel-download-clicked(k) => { root.cancel-download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 < root.multilingual-models.length : ModelCard {
                            width: (parent.width - Theme.space-10) / 2;
                            item: root.multilingual-models[row-idx * 2 + 1];
                            select-clicked(k) => { root.select-model(k); }
                            download-clicked(k) => { root.download-model(k); }
                            cancel-download-clicked(k) => { root.cancel-download-model(k); }
                            delete-clicked(k) => { root.delete-model(k); }
                        }
                        if row-idx * 2 + 1 >= root.multilingual-models.length : Rectangle {
                            width: (parent.width - Theme.space-10) / 2;
                        }
                    }
                }
                if !root.two-col : VerticalLayout {
                    spacing: Theme.space-10;
                    for m in root.multilingual-models : ModelCard {
                        item: m;
                        select-clicked(k) => { root.select-model(k); }
                        download-clicked(k) => { root.download-model(k); }
                        cancel-download-clicked(k) => { root.cancel-download-model(k); }
                        delete-clicked(k) => { root.delete-model(k); }
                    }
                }
            }
        }
    }
}
