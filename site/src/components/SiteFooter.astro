---
import Wordmark from './Wordmark.astro';
import WaveField from './WaveField.astro';
import { REPO_URL, STORE_URL, SUPPORT_EMAIL } from '../lib/site';
import { DEFAULT_LANG, pagePath, t, tSplit } from '../lib/i18n';
interface Props { lang?: string }
const { lang = DEFAULT_LANG } = Astro.props;
const [madeA, madeB] = tSplit(lang, 'footer.madeBy');
---
<footer class="site-footer" data-wf="rings">
  <WaveField />
  <div class="f-brand">
    <a href={pagePath(lang)} aria-label={t(lang, 'nav.home')}><Wordmark height={22} label="Eqho" /></a>
  </div>
  <div class="f-group">
    <h2>{t(lang, 'footer.get')}</h2>
    <ul>
      <li><a href={STORE_URL}>{t(lang, 'footer.store')}</a></li>
      <li><a href={pagePath(lang, 'changelog')}>{t(lang, 'footer.changelog')}</a></li>
      <li><a href={REPO_URL}>{t(lang, 'footer.source')}</a></li>
    </ul>
  </div>
  <div class="f-group">
    <h2>{t(lang, 'footer.help')}</h2>
    <ul>
      <li><a href={`mailto:${SUPPORT_EMAIL}`}>{t(lang, 'footer.support')}</a></li>
      <li><a href={pagePath(lang, 'privacy')}>{t(lang, 'footer.privacy')}</a></li>
    </ul>
  </div>
  <div class="f-group">
    <h2>{t(lang, 'footer.about')}</h2>
    <ul>
      <li>{madeA}<a href="https://damt.xyz">damt.xyz</a>{madeB}</li>
      <li>{t(lang, 'footer.copyright')}</li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    display: grid; gap: 32px 40px;
    grid-template-columns: minmax(160px, 1.6fr) repeat(3, minmax(140px, 1fr));
    border-block-start: 1px solid var(--line); background: var(--canvas);
    padding-block: 48px 56px; padding-inline: var(--pad-x);
    color: var(--muted); font-size: 0.9375rem;
  }
  .f-brand a { display: inline-block; color: var(--text); }
  .f-brand :global(svg) { display: block; height: 22px; width: auto; }
  h2 { font-size: 12px; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-block-end: 12px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  a { color: var(--text); text-decoration: none; transition: color var(--ease); }
  .f-group a:hover { color: var(--accent); text-decoration: underline; transition-duration: 0s; }
  @media (max-width: 760px) {
    .site-footer { grid-template-columns: 1fr 1fr; }
    .f-brand { grid-column: 1 / -1; }
  }
</style>
