---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LEGACY_URL, STORE_URL, VERSION } from '../lib/site';
const title = "Eqho — Offline Dictation. Speak, It Types.";
const description = "Offline dictation for Windows. Press a hotkey, speak, and your words appear in any app. 100% offline — your voice never leaves your computer. Rebuilt in Rust (~3.4 MB idle RAM) with fast local Vulkan GPU and multi-core CPU transcription. On the Microsoft Store with a 15-day free trial.";
const author = "Daniel Mevit";
const faq = [
  { q: "What does it cost?", a: "Eqho is a one-time purchase on the Microsoft Store, with a 15-day free trial first. No subscription, no word limits and no ads." },
  { q: "Is it safe to install?", a: "Yes. Eqho comes from the Microsoft Store, which checks every app before it is listed. It goes online only to download the voice model you pick and to let Windows check your Store licence." },
  { q: "Is my voice really never uploaded?", a: "Really. Transcription runs on your own processor or graphics card, using state-of-the-art open speech models (OpenAI's Whisper family via whisper.cpp). Eqho touches the network only when you download a voice model. The code is open — you can check." },
  { q: "How accurate is it?", a: "Whisper-class accuracy — the same model family used by professional transcription services. You choose the trade-off: compact Q5 models (from 60\u00a0MB) are fast even on a laptop CPU, while larger models handle tougher audio and accents." },
  { q: "What do I need to run it?", a: "A 64-bit PC with Windows 10 or 11, plus disk space for your chosen voice model (60\u00a0MB to 1.5\u00a0GB). A graphics card makes it faster (NVIDIA, AMD or Intel via Vulkan) but isn't required." },
  { q: "Does it work on Linux or macOS?", a: "Eqho 0.9 runs on Windows, and a macOS version is in development. The previous version (0.8.10) runs on Linux and macOS; it is on GitHub.", link: LEGACY_URL },
  { q: "How do I remove it?", a: "Uninstall it from Windows Settings; that also removes its settings." },
];
const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Eqho",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11",
  description,
  url: "https://danielmevit.github.io/eqho/",
  downloadUrl: STORE_URL,
  installUrl: STORE_URL,
  softwareVersion: VERSION,
  author: { "@type": "Person", name: "Daniel Mevit", url: "https://github.com/danielmevit" },
  publisher: { "@type": "Organization", name: "damt.xyz", url: "https://damt.xyz" },
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  keywords: "speech to text, voice typing, offline dictation, OpenAI Whisper, whisper.cpp, Rust dictation app, Vulkan speech to text, AMD GPU dictation, cross-vendor GPU transcription, private speech to text, local voice recognition",
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href="https://danielmevit.github.io/eqho/" />

    <!-- Tab Icons for Light Mode Tabs -->
    <link rel="icon" type="image/png" sizes="32x32" href="https://raw.githubusercontent.com/DanielMevit/eqho/main/assets/logo_32_dark.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="64x64" href="https://raw.githubusercontent.com/DanielMevit/eqho/main/assets/logo_64_dark.png" media="(prefers-color-scheme: light)" />

    <!-- Tab Icons for Dark Mode Tabs -->
    <link rel="icon" type="image/png" sizes="32x32" href="https://raw.githubusercontent.com/DanielMevit/eqho/main/assets/logo_32_white.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="64x64" href="https://raw.githubusercontent.com/DanielMevit/eqho/main/assets/logo_64_white.png" media="(prefers-color-scheme: dark)" />

    <link
      rel="alternate"
      type="text/plain"
      href="https://danielmevit.github.io/eqho/llms.txt"
      title="LLM Documentation"
    />

    <meta name="description" content={description} />
    <meta name="keywords" content="speech to text, voice to text, dictation software, offline speech recognition, dictation app, voice typing for Windows, OpenAI Whisper app, whisper.cpp GUI, Rust dictation app, Vulkan speech to text, AMD GPU dictation, AMD Radeon voice to text, Intel Arc dictation, cross-vendor GPU transcription, private speech to text, local voice recognition, no-cloud transcription" />
    <meta name="author" content={author} />

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph for Link Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://danielmevit.github.io/eqho/" />
    <meta property="og:image" content="https://raw.githubusercontent.com/DanielMevit/eqho/main/logo/logo_horizontal_dark.png" />
    <meta property="og:site_name" content="Eqho" />

    <!-- Structured data for search engines + AI scrapers (SoftwareApplication) -->
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

    <style>
      :root {
        --bg: #0d1117;
        --bg-soft: #10161f;
        --card: #161b22;
        --card-hover: #1b222c;
        --text: #c9d1d9;
        --heading: #ffffff;
        --blue: #58a6ff;
        --blue-deep: #1f6feb;
        --muted: #8b949e;
        --border: #30363d;
        --light-card: #f6f8fa;
        --light-text: #1a1c1f;
        --light-muted: #57606a;
        --radius: 16px;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        margin: 0;
        -webkit-font-smoothing: antialiased;
      }

      img { max-width: 100%; height: auto; }

      .wrap { width: 100%; padding: 0 clamp(16px, 4vw, 64px); }

      .btn {
        display: inline-flex; align-items: center; gap: 0.55rem;
        background: var(--blue-deep); color: #fff !important;
        padding: 0.7rem 1.3rem; border-radius: 999px;
        font-weight: 600; text-decoration: none; border: 1px solid transparent;
        transition: transform .12s ease, background .12s ease;
      }
      .btn:hover { background: #1a5fd0; transform: translateY(-1px); }
      .btn.ghost {
        background: transparent; color: var(--text) !important;
        border-color: var(--border);
      }
      .btn.ghost:hover { border-color: var(--muted); }
      .btn.big { padding: 0.95rem 1.7rem; font-size: 1.05rem; }

      /* ---------- Hero ---------- */
      header.hero { padding-block: 4rem 3rem; text-align: center; }
      .eyebrow {
        display: inline-block; font-size: 0.85rem; font-weight: 600;
        letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue);
        border: 1px solid var(--border); border-radius: 999px;
        padding: 0.35rem 0.9rem; margin-bottom: 1.6rem; background: var(--bg-soft);
      }
      h1 {
        font-size: clamp(2.8rem, 7.5vw, 5rem);
        font-weight: 800; letter-spacing: -0.03em; line-height: 1.05;
        color: var(--heading); margin: 0 0 1.2rem;
      }
      h1 .accent { color: var(--blue); }
      .sub {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--muted); max-width: 620px; margin: 0 auto 2.2rem;
      }
      .cta-row { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-bottom: 0.9rem; }
      .cta-note { font-size: 0.85rem; color: var(--muted); margin: 0.4rem 0 0; }
      .cta-try { color: var(--text); font-size: 0.95rem; margin: 0; }

      /* The overlay, recreated: preview panel + the listening pill */
      .overlay-demo { max-width: 640px; margin: 3.2rem auto 0; }
      .overlay-demo .panel {
        background: var(--card); border: 1px solid var(--border);
        border-radius: 18px; padding: 1rem 1.3rem; text-align: left;
        color: var(--text); font-size: 1.02rem; box-shadow: 0 18px 50px rgba(0,0,0,.45);
      }
      .overlay-demo .panel .caret {
        display: inline-block; width: 2px; height: 1.05em; background: var(--blue);
        vertical-align: text-bottom; margin-left: 2px; animation: blink 1.1s steps(1) infinite;
      }
      @keyframes blink { 50% { opacity: 0; } }
      .overlay-demo .pill { margin-top: 0.8rem; }
      .overlay-demo .pill img { width: min(380px, 72%); display: block; margin: 0 auto; }

      /* ---------- Sections ---------- */
      section { padding-block: 4.5rem 0; }
      h2 {
        font-size: clamp(1.9rem, 4.5vw, 2.8rem); font-weight: 700;
        letter-spacing: -0.02em; color: var(--heading);
        margin: 0 0 0.7rem; text-align: center;
      }
      .lede { text-align: center; color: var(--muted); max-width: 640px; margin: 0 auto 2.6rem; font-size: 1.08rem; }

      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
      .step {
        background: var(--card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.6rem;
      }
      .step .num {
        font-size: 2.4rem; font-weight: 800; color: var(--blue); line-height: 1;
        margin-bottom: 0.7rem;
      }
      .step h3 { color: var(--heading); font-size: 1.15rem; margin: 0 0 0.4rem; }
      .step p { margin: 0; color: var(--muted); font-size: 0.98rem; }
      .step kbd {
        background: var(--bg); border: 1px solid var(--border); border-bottom-width: 2px;
        border-radius: 6px; padding: 0.1rem 0.45rem; font-size: 0.9em; color: var(--heading);
      }

      .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }
      .card {
        background: var(--card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.6rem;
        transition: background .12s ease;
      }
      .card:hover { background: var(--card-hover); }
      .card h3 { color: var(--heading); font-size: 1.12rem; margin: 0 0 0.45rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.97rem; }

      /* ---------- Theme duo (the pill in both worlds) ---------- */
      .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
      .duo .world {
        border-radius: var(--radius); border: 1px solid var(--border);
        padding: 2.2rem 1.6rem; text-align: center;
      }
      .duo .world img { width: min(340px, 86%); }
      .duo .world.dark { background: var(--bg-soft); }
      .duo .world.light { background: var(--light-card); border-color: #d0d7de; }
      .duo .world p { margin: 1.1rem 0 0; font-size: 0.95rem; }
      .duo .world.dark p { color: var(--muted); }
      .duo .world.light p { color: var(--light-muted); }

      /* ---------- Screenshot ---------- */
      .shot {
        width: min(100%, 1400px); height: auto;
        border-radius: var(--radius); border: 1px solid var(--border);
        box-shadow: 0 24px 70px rgba(0,0,0,.5); display: block; margin: 0 auto;
      }

      .langs {
        display: flex; flex-wrap: wrap; justify-content: center; row-gap: 0.2rem;
        color: var(--muted); max-width: 760px; margin: 1.8rem auto 0; padding: 0; line-height: 2;
      }
      .langs span { white-space: nowrap; }
      .langs span + span::before { content: "·"; color: var(--border); margin: 0 0.55rem; }

      /* ---------- Install ---------- */
      .step a { color: var(--blue); }
      .dl-fine { text-align: center; color: var(--muted); font-size: 0.92rem; margin: 1.6rem 0 0; }
      .dl-fine a { color: var(--blue); text-decoration: none; }
      .dl-fine a:hover { text-decoration: underline; }

      /* ---------- FAQ ---------- */
      .faq { max-width: 760px; margin: 1.8rem auto 0; }
      .faq a { color: var(--blue); }
      .faq details {
        background: var(--card); border: 1px solid var(--border);
        border-radius: 12px; padding: 1rem 1.3rem; margin-bottom: 0.8rem;
      }
      .faq summary { cursor: pointer; font-weight: 600; color: var(--heading); }
      .faq p { color: var(--muted); margin: 0.8rem 0 0.2rem; }

      /* ---------- Responsive ---------- */
      @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, 1fr); } }
      @media (max-width: 860px) {
        .steps { grid-template-columns: 1fr; }
        .duo { grid-template-columns: 1fr; }
        header.hero { padding-top: 3.2rem; }
        .cards { grid-template-columns: 1fr; }
        section { padding-top: 3.4rem; }
      }
      @media (max-width: 480px) {
        .btn.big { width: 100%; justify-content: center; }
        .cta-row { flex-direction: column; align-items: stretch; }
      }
      @media (prefers-reduced-motion: reduce) {
        .overlay-demo .panel .caret { animation: none; }
        .btn { transition: none; }
      }
    </style>
  </head>

  <body>
    <SiteHeader />

    <header class="hero">
      <div class="wrap">
        <span class="eyebrow">Open source · 100% offline · Native Rust</span>
        <h1>Speak.<br /><span class="accent">It types.</span></h1>
        <p class="sub">
          Eqho turns your voice into text in any app on your computer —
          email, documents, chat, code. Rebuilt in Rust for instant startup,
          tiny memory use, and complete privacy on your own machine.
        </p>
        <div class="cta-row">
          <a class="btn big" href={STORE_URL}>Get it on the Microsoft Store</a>
          <a class="btn big ghost" href="#how">How it works</a>
        </div>
        <p class="cta-try">Try it free for 15 days, then buy it once.</p>
        <p class="cta-note">Windows 10 and 11 · v{VERSION} · ~3.4 MB idle RAM · No account, nothing uploaded</p>

        <!-- The actual overlay, recreated: your words fill the panel while the pill listens -->
        <div class="overlay-demo" aria-hidden="true">
          <div class="panel">This is what dictating with Eqho looks like — your words appear live while you speak<span class="caret"></span></div>
          <div class="pill"><img src="assets/pill_dark.webp" alt="" loading="eager" /></div>
        </div>
      </div>
    </header>

    <main>
      <section id="how">
        <div class="wrap">
          <h2>Three steps. That's the whole app.</h2>
          <p class="lede">No setup rituals, no cloud accounts. Install it, pick a voice model once, and dictate.</p>
          <div class="steps">
            <div class="step">
              <div class="num">1</div>
              <h3>Click where you want text</h3>
              <p>Any app works — your browser, Word, Slack, a code editor. If you can type there, you can speak there.</p>
            </div>
            <div class="step">
              <div class="num">2</div>
              <h3>Press <kbd>Alt</kbd> + <kbd>Q</kbd> and talk</h3>
              <p>A small pill appears and listens — hover or pin its micro-bar for quick controls, and choose Batch or Live delivery. The hotkey is yours to change.</p>
            </div>
            <div class="step">
              <div class="num">3</div>
              <h3>Press it again — done</h3>
              <p>Your words land cleanly in the focused app, formatted and capitalized. Say "period" or "new line" if you like dictating punctuation.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="why">
        <div class="wrap">
          <h2>Private. Fast. Actually yours.</h2>
          <p class="lede">Most dictation tools send your voice to someone's server and charge you monthly for it. Eqho does neither.</p>
          <div class="cards">
            <div class="card">
              <h3>Nothing leaves your computer</h3>
              <p>Speech recognition runs entirely on your machine. No cloud, no account, no audio uploads — ever. The only download is the voice model itself, once.</p>
            </div>
            <div class="card">
              <h3>Buy once, keep it</h3>
              <p>A one-time purchase on the Microsoft Store after a 15-day free trial. No subscription, no word limits, no account. The code is open source under AGPL-3.0.</p>
            </div>
            <div class="card">
              <h3>Native speed on any PC</h3>
              <p>Starts in ~38 ms and idles at ~3.4 MB RAM. Runs fast on NVIDIA, AMD and Intel graphics cards via Vulkan — or across all CPU cores with compact Q5 models on PCs without a GPU.</p>
            </div>
            <div class="card">
              <h3>99 languages, honestly tiered</h3>
              <p>13 hand-tuned for dictation, 20 more with strong accuracy — and the rest of Whisper's 99 available too with crisp vector flags, clearly marked experimental.</p>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2>The listening pill</h2>
          <p class="lede">
            When Eqho hears you, you'll know — the pill breathes and ripples with your voice,
            reveals compact controls on hover (or pinned), and follows your theme, light or dark.
          </p>
          <div class="duo">
            <div class="world dark">
              <img src="assets/pill_dark.webp" alt="Eqho's listening pill in dark theme — flowing blue waves" loading="lazy" />
              <p>Dark theme — Deep Navy Blend with deep blues that ride every word.</p>
            </div>
            <div class="world light">
              <img src="assets/pill_light.webp" alt="Eqho's listening pill in light theme — soft blue waves on pearl" loading="lazy" />
              <p>Light theme — frosted glass with the same living wave.</p>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2>Settings you'll actually understand</h2>
          <p class="lede">
            One clean dashboard: pick a voice model by size and accuracy, set your hotkey,
            browse your dictation history, teach it your jargon. That's it.
          </p>
          <img class="shot" src="assets/eqho_app_screenshot.webp" alt="The Eqho dashboard — model picker, hotkey, history and settings" loading="lazy" width="960" />
          <p class="langs">
            <span>English</span><span>Spanish</span><span>Mandarin</span><span>Japanese</span><span>Korean</span><span>Vietnamese</span><span>Arabic</span><span>Ukrainian</span><span>French</span><span>German</span><span>Portuguese</span><span>Russian</span><span>Italian</span><span>+ 20 with strong accuracy</span><span>+ 66 experimental — quality varies</span>
          </p>
        </div>
      </section>

      <section id="downloads">
        <div class="wrap">
          <h2>Get started in a minute</h2>
          <p class="lede">Windows 10 or 11, 64-bit. The Microsoft Store installs Eqho and keeps it up to date.</p>
          <div class="steps">
            <div class="step">
              <div class="num">1</div>
              <h3>Get it from the Microsoft Store</h3>
              <p>Open Eqho on the <a href={STORE_URL}>Microsoft Store</a> and install it.</p>
            </div>
            <div class="step">
              <div class="num">2</div>
              <h3>Try it free for 15 days</h3>
              <p>Pick a voice model once, press <kbd>Alt</kbd> + <kbd>Q</kbd> and talk. Every feature works during the trial.</p>
            </div>
            <div class="step">
              <div class="num">3</div>
              <h3>Buy it once</h3>
              <p>Keep Eqho after the trial with a one-time purchase in the Store.</p>
            </div>
          </div>
          <p class="dl-fine">On Linux or macOS? The previous version of Eqho (0.8.10) is <a href={LEGACY_URL}>on GitHub</a>.</p>
        </div>
      </section>

      <section id="faq">
        <div class="wrap">
          <h2>Fair questions</h2>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.link ? <>{f.a.replace(/; it is on GitHub\.$/, '; it is ')}<a href={f.link}>on GitHub</a>.</> : f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
